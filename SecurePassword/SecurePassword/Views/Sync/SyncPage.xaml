<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:SecurePassword.ViewModels.Sync"
             xmlns:converters="clr-namespace:SecurePassword.Converters"
             x:Class="SecurePassword.Views.Sync.SyncPage"
             x:DataType="vm:SyncViewModel"
             Title="Передать данные"
             NavigationPage.HasNavigationBar="False"
             Background="{StaticResource PageBackgroundBrush}">
    <ContentPage.Resources>
        <ResourceDictionary>
            <converters:InverseBoolConverter x:Key="InverseBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" BackgroundColor="#33FFFFFF" StrokeThickness="0" Padding="20,12">
            <Grid ColumnDefinitions="*,Auto">
                <Label Text="Передать данные" Style="{StaticResource HeaderTitleStyle}" VerticalOptions="Center" />
                <Button Grid.Column="1" Text="&#x2715;" FontSize="16" FontAttributes="Bold"
                        Style="{StaticResource SecondaryButtonStyle}" HeightRequest="40" WidthRequest="40" Padding="0"
                        Clicked="OnCloseClicked" AutomationProperties.Name="Закрыть экран передачи" />
            </Grid>
        </Border>

        <ScrollView Grid.Row="1" Padding="16,12,16,24">
            <VerticalStackLayout Spacing="16" MaximumWidthRequest="520" HorizontalOptions="Center">
                <Border Style="{StaticResource GlassCardStyle}">
                    <VerticalStackLayout Spacing="5">
                        <Label Text="Передать защищённое хранилище" Style="{StaticResource SectionHeaderStyle}" />
                        <Label Text="Отсканируйте QR получателя или укажите данные вручную. Передача выполняется через существующее SPP1-сопряжение."
                               Style="{StaticResource HintLabelStyle}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource GlassCardStyle}" IsVisible="{Binding CanScanQr}">
                    <VerticalStackLayout Spacing="12">
                        <Button Text="Сканировать QR получателя" Style="{StaticResource PrimaryButtonStyle}"
                                Clicked="OnScanQrClicked" IsEnabled="{Binding IsOperationActive, Converter={StaticResource InverseBoolConverter}}"
                                AutomationProperties.Name="Сканировать QR получателя" />
                        <Grid IsVisible="{Binding IsScannerVisible}" HeightRequest="280">
                            <ContentView x:Name="ScannerHost" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Button Text="Ввести данные вручную" Style="{StaticResource SecondaryButtonStyle}"
                        Command="{Binding ToggleManualEntryCommand}"
                        AutomationProperties.Name="Ввести данные вручную" />

                <Border Style="{StaticResource GlassCardStyle}" IsVisible="{Binding ShowManualEntry}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Данные получателя" Style="{StaticResource SectionHeaderStyle}" />
                        <VerticalStackLayout Spacing="4">
                            <Label Text="IP-адрес устройства-получателя" Style="{StaticResource FieldLabelStyle}" />
                            <Border Style="{StaticResource FieldBorderStyle}" Padding="16,0">
                                <Entry Text="{Binding PeerAddress}" Placeholder="Например: 192.168.0.15"
                                       PlaceholderColor="{StaticResource TextMuted}" TextColor="{StaticResource TextPrimary}"
                                       Keyboard="Url" IsEnabled="{Binding IsOperationActive, Converter={StaticResource InverseBoolConverter}}"
                                       AutomationProperties.Name="IP-адрес получателя" HeightRequest="50" />
                            </Border>
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Одноразовый код сопряжения" Style="{StaticResource FieldLabelStyle}" />
                            <Border Style="{StaticResource FieldBorderStyle}" Padding="16,0">
                                <Entry Text="{Binding PeerPairingCode}" Placeholder="XXXX-XXXX-XXXX"
                                       PlaceholderColor="{StaticResource TextMuted}" TextColor="{StaticResource TextPrimary}"
                                       IsEnabled="{Binding IsOperationActive, Converter={StaticResource InverseBoolConverter}}"
                                       AutomationProperties.Name="Код сопряжения" HeightRequest="50" />
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <Border IsVisible="{Binding HasTransferableVault, Converter={StaticResource InverseBoolConverter}}"
                        BackgroundColor="#FFF7E6" Stroke="#FADFA1" StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14,10">
                    <Label Text="• На этом устройстве пока нет готового хранилища для передачи." TextColor="#9A6700" FontSize="13" />
                </Border>

                <Border IsVisible="{Binding HasValidationError}" BackgroundColor="#FFF4F4" Stroke="{StaticResource DangerBorder}"
                        StrokeThickness="1" StrokeShape="RoundRectangle 12" Padding="14,10">
                    <Label Text="{Binding ValidationError}" TextColor="{StaticResource Danger}" FontSize="13"
                           AutomationProperties.Name="Ошибка передачи" />
                </Border>

                <Border IsVisible="{Binding ShowResultBanner}" Style="{StaticResource GlassCardStyle}">
                    <Label Text="{Binding ResultMessage}" TextColor="{StaticResource TextPrimary}" FontSize="13" />
                </Border>

                <Border IsVisible="{Binding ShowProgress}" Style="{StaticResource GlassCardStyle}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="{Binding StatusMessage}" Style="{StaticResource HintLabelStyle}" />
                        <ProgressBar Progress="{Binding ProgressValue}" ProgressColor="{StaticResource Primary}" HeightRequest="6" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="8">
                    <Button Text="Передать хранилище" Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding StartSendCommand}" AutomationProperties.Name="Передать хранилище" />
                    <Button Text="Отменить" Style="{StaticResource SecondaryButtonStyle}"
                            Command="{Binding CancelSyncCommand}" IsVisible="{Binding IsOperationActive}" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
