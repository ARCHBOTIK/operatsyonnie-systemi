<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="SecurePassword.MasterPasswordPage"
    Title="Мастер-пароль"
    NavigationPage.HasNavigationBar="False"
    Background="{StaticResource PageBackgroundBrush}">

    <ScrollView>
        <Grid Padding="18,18,18,24">
            <VerticalStackLayout
                MaximumWidthRequest="470"
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="18">
                <Border Style="{StaticResource GlassCardStyle}" Padding="24">
                    <VerticalStackLayout Spacing="18">
                        <VerticalStackLayout Spacing="6">
                            <Label
                                x:Name="TitleLabel"
                                Text="Мастер-пароль"
                                FontSize="30"
                                FontAttributes="Bold"
                                TextColor="#0F1720" />
                            <Label
                                x:Name="SubtitleLabel"
                                Text="Введите пароль для входа"
                                FontSize="15"
                                TextColor="#60707A" />
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="LoginBlock" IsVisible="False" Spacing="16">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Пароль" Style="{StaticResource FieldLabelStyle}" />
                                <Border Style="{StaticResource FieldBorderStyle}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,0,8,0">
                                        <Entry
                                            x:Name="LoginPasswordEntry"
                                            Grid.Column="0"
                                            Placeholder="Введите мастер-пароль"
                                            PlaceholderColor="#8A98A3"
                                            TextColor="#17212B"
                                            IsPassword="True"
                                            FontSize="15"
                                            BackgroundColor="Transparent"
                                            Margin="16,0,0,0"
                                            HeightRequest="56"
                                            ClearButtonVisibility="WhileEditing"
                                            Completed="OnLoginCompleted" />
                                        <Button
                                            x:Name="LoginToggleButton"
                                            Grid.Column="1"
                                            Text="Показать"
                                            Style="{StaticResource InlineSmallButtonStyle}"
                                            VerticalOptions="Center"
                                            Clicked="OnToggleLoginPasswordClicked" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                            <Button
                                Text="Открыть хранилище"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Clicked="OnLoginClicked" />
                            <Button
                                Text="Сбросить пароль"
                                Style="{StaticResource DangerButtonStyle}"
                                Clicked="OnGoResetClicked" />
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="CreateBlock" IsVisible="False" Spacing="16">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Новый пароль" Style="{StaticResource FieldLabelStyle}" />
                                <Border Style="{StaticResource FieldBorderStyle}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,0,8,0">
                                        <Entry
                                            x:Name="CreatePasswordEntry"
                                            Grid.Column="0"
                                            Placeholder="Придумайте пароль"
                                            PlaceholderColor="#8A98A3"
                                            TextColor="#17212B"
                                            IsPassword="True"
                                            FontSize="15"
                                            BackgroundColor="Transparent"
                                            Margin="16,0,0,0"
                                            HeightRequest="56"
                                            ClearButtonVisibility="WhileEditing"
                                            Completed="OnCreatePasswordCompleted" />
                                        <Button
                                            x:Name="CreatePasswordToggleButton"
                                            Grid.Column="1"
                                            Text="Показать"
                                            Style="{StaticResource InlineSmallButtonStyle}"
                                            VerticalOptions="Center"
                                            Clicked="OnToggleCreatePasswordClicked" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Подтверждение пароля" Style="{StaticResource FieldLabelStyle}" />
                                <Border Style="{StaticResource FieldBorderStyle}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,0,8,0">
                                        <Entry
                                            x:Name="CreateConfirmEntry"
                                            Grid.Column="0"
                                            Placeholder="Повторите пароль"
                                            PlaceholderColor="#8A98A3"
                                            TextColor="#17212B"
                                            IsPassword="True"
                                            FontSize="15"
                                            BackgroundColor="Transparent"
                                            Margin="16,0,0,0"
                                            HeightRequest="56"
                                            ClearButtonVisibility="WhileEditing"
                                            Completed="OnCreateCompleted" />
                                        <Button
                                            x:Name="CreateConfirmToggleButton"
                                            Grid.Column="1"
                                            Text="Показать"
                                            Style="{StaticResource InlineSmallButtonStyle}"
                                            VerticalOptions="Center"
                                            Clicked="OnToggleCreateConfirmClicked" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                            <Button
                                Text="Создать хранилище"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Clicked="OnCreateClicked" />
                        </VerticalStackLayout>

                        <VerticalStackLayout x:Name="ResetBlock" IsVisible="False" Spacing="16">
                            <Border
                                StrokeThickness="0"
                                BackgroundColor="#FFF1F1"
                                StrokeShape="RoundRectangle 16"
                                Padding="14,12">
                                <Label
                                    Text="Сброс удалит существующую базу и ключ. После этого можно создать новое хранилище или принять базу по P2P."
                                    FontSize="13"
                                    TextColor="#B42318" />
                            </Border>
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Новый пароль" Style="{StaticResource FieldLabelStyle}" />
                                <Border Style="{StaticResource FieldBorderStyle}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,0,8,0">
                                        <Entry
                                            x:Name="ResetPasswordEntry"
                                            Grid.Column="0"
                                            Placeholder="Новый мастер-пароль"
                                            PlaceholderColor="#8A98A3"
                                            TextColor="#17212B"
                                            IsPassword="True"
                                            FontSize="15"
                                            BackgroundColor="Transparent"
                                            Margin="16,0,0,0"
                                            HeightRequest="56"
                                            ClearButtonVisibility="WhileEditing"
                                            Completed="OnResetPasswordCompleted" />
                                        <Button
                                            x:Name="ResetPasswordToggleButton"
                                            Grid.Column="1"
                                            Text="Показать"
                                            Style="{StaticResource InlineSmallButtonStyle}"
                                            VerticalOptions="Center"
                                            Clicked="OnToggleResetPasswordClicked" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Подтверждение нового пароля" Style="{StaticResource FieldLabelStyle}" />
                                <Border Style="{StaticResource FieldBorderStyle}">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,0,8,0">
                                        <Entry
                                            x:Name="ResetConfirmEntry"
                                            Grid.Column="0"
                                            Placeholder="Повторите новый пароль"
                                            PlaceholderColor="#8A98A3"
                                            TextColor="#17212B"
                                            IsPassword="True"
                                            FontSize="15"
                                            BackgroundColor="Transparent"
                                            Margin="16,0,0,0"
                                            HeightRequest="56"
                                            ClearButtonVisibility="WhileEditing"
                                            Completed="OnResetCompleted" />
                                        <Button
                                            x:Name="ResetConfirmToggleButton"
                                            Grid.Column="1"
                                            Text="Показать"
                                            Style="{StaticResource InlineSmallButtonStyle}"
                                            VerticalOptions="Center"
                                            Clicked="OnToggleResetConfirmClicked" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                            <Button
                                Text="Сбросить и создать заново"
                                Style="{StaticResource DangerButtonStyle}"
                                Clicked="OnResetClicked" />
                            <Button
                                Text="Вернуться ко входу"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Clicked="OnBackToLoginClicked" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="10">
                            <Button
                                x:Name="ToggleImportButton"
                                Text="Импорт базы по P2P"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Clicked="OnToggleImportClicked" />

                            <VerticalStackLayout x:Name="ImportPanel" IsVisible="False" Spacing="10">
                                <Border
                                    StrokeThickness="0"
                                    BackgroundColor="#EBF5FF"
                                    StrokeShape="RoundRectangle 16"
                                    Padding="14,12">
                                    <Label
                                        x:Name="ImportHintLabel"
                                        FontSize="13"
                                        TextColor="#1D4ED8" />
                                </Border>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Button
                                        x:Name="SyncButton"
                                        Grid.Column="0"
                                        Text="Принять базу"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Clicked="OnReceiveSyncClicked" />
                                    <Button
                                        x:Name="SyncCancelButton"
                                        Grid.Column="1"
                                        Text="Отмена"
                                        Style="{StaticResource InlineSmallButtonStyle}"
                                        IsVisible="False"
                                        Clicked="OnCancelSyncClicked" />
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>

                        <Border
                            x:Name="SyncStatusContainer"
                            IsVisible="False"
                            StrokeThickness="0"
                            StrokeShape="RoundRectangle 14"
                            Padding="14,12">
                            <Label
                                x:Name="SyncStatusLabel"
                                FontSize="13"
                                LineBreakMode="WordWrap" />
                        </Border>

                        <Border
                            x:Name="StatusContainer"
                            IsVisible="False"
                            StrokeThickness="0"
                            BackgroundColor="#ECFFF8"
                            StrokeShape="RoundRectangle 14"
                            Padding="14,12">
                            <Label
                                x:Name="StatusLabel"
                                FontSize="13"
                                TextColor="#0F8B6D" />
                        </Border>

                        <Border
                            x:Name="ErrorContainer"
                            IsVisible="False"
                            StrokeThickness="0"
                            BackgroundColor="#FFF2F2"
                            StrokeShape="RoundRectangle 14"
                            Padding="14,12">
                            <Label
                                x:Name="ErrorLabel"
                                FontSize="13"
                                TextColor="#C62828" />
                        </Border>

                        <Border
                            x:Name="CapsLockContainer"
                            IsVisible="False"
                            StrokeThickness="0"
                            BackgroundColor="#FFF7E8"
                            StrokeShape="RoundRectangle 14"
                            Padding="14,12">
                            <Label
                                Text="Caps Lock включён"
                                FontSize="13"
                                TextColor="#B26A00" />
                        </Border>

                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
