<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:components="clr-namespace:SecurePassword.Components"
    x:Class="SecurePassword.MasterPasswordPage"
    Title="Мастер-пароль"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#DFF7F2">
    <ContentPage.Resources>
        <LinearGradientBrush x:Key="PageBackgroundBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#DFF7F2" Offset="0.00" />
            <GradientStop Color="#CDEEE8" Offset="0.52" />
            <GradientStop Color="#EDF8FF" Offset="1.00" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PrimaryBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#19A38C" Offset="0.0" />
            <GradientStop Color="#41C7B2" Offset="1.0" />
        </LinearGradientBrush>
        <Style x:Key="GlassCardStyle" TargetType="Border">
            <Setter Property="Stroke" Value="#66FFFFFF" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="BackgroundColor" Value="#55FFFFFF" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="30" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FieldLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#138F7A" />
        </Style>
        <Style x:Key="HintLabelStyle" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="#6A7882" />
        </Style>
        <Style x:Key="FieldBorderStyle" TargetType="Border">
            <Setter Property="Stroke" Value="#D9ECE7" />
            <Setter Property="StrokeThickness" Value="1" />
            <Setter Property="BackgroundColor" Value="#CCFFFFFF" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="16" />
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="HeightRequest" Value="56" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="White" />
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
        </Style>
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="HeightRequest" Value="52" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#1C4E49" />
            <Setter Property="BackgroundColor" Value="#EAF8F5" />
            <Setter Property="BorderColor" Value="#CDEAE4" />
            <Setter Property="BorderWidth" Value="1" />
        </Style>
        <Style x:Key="DangerButtonStyle" TargetType="Button">
            <Setter Property="HeightRequest" Value="52" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#B12D2D" />
            <Setter Property="BackgroundColor" Value="#FFF4F4" />
            <Setter Property="BorderColor" Value="#F1D1D1" />
            <Setter Property="BorderWidth" Value="1" />
        </Style>
        <Style x:Key="InlineSmallButtonStyle" TargetType="Button">
            <Setter Property="HeightRequest" Value="40" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontAttributes" Value="Bold" />
            <Setter Property="TextColor" Value="#4C5A64" />
            <Setter Property="BackgroundColor" Value="#F3FBF9" />
            <Setter Property="BorderColor" Value="#D9ECE7" />
            <Setter Property="BorderWidth" Value="1" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <BlazorWebView
            x:Name="AppHost"
            HostPage="wwwroot/index.html"
            Margin="0"
            BlazorWebViewInitializing="blazorWebView_BlazorWebViewInitializing"
            BlazorWebViewInitialized="blazorWebView_BlazorWebViewInitialized">
            <BlazorWebView.RootComponents>
                <RootComponent Selector="#app" ComponentType="{x:Type components:Routes}" />
            </BlazorWebView.RootComponents>
        </BlazorWebView>

        <Grid x:Name="AuthOverlay" Background="{StaticResource PageBackgroundBrush}">
            <ScrollView>
                <Grid Padding="18,18,18,24">
                    <VerticalStackLayout
                        MaximumWidthRequest="470"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Spacing="18">
                        <Border Style="{StaticResource GlassCardStyle}" Padding="24">
                            <VerticalStackLayout Spacing="18">
                                <VerticalStackLayout Spacing="6">
                                    <Label
                                        x:Name="TitleLabel"
                                        Text="Мастер-пароль"
                                        FontSize="30"
                                        FontAttributes="Bold"
                                        TextColor="#0F1720" />
                                    <Label
                                        x:Name="SubtitleLabel"
                                        Text="Введите пароль для входа"
                                        FontSize="15"
                                        TextColor="#60707A" />
                                </VerticalStackLayout>

                                <VerticalStackLayout x:Name="LoginBlock" IsVisible="False" Spacing="16">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="Пароль" Style="{StaticResource FieldLabelStyle}" />
                                        <Border Style="{StaticResource FieldBorderStyle}">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,0,8,0">
                                                <Entry
                                                    x:Name="LoginPasswordEntry"
                                                    Grid.Column="0"
                                                    Placeholder="Введите мастер-пароль"
                                                    PlaceholderColor="#8A98A3"
                                                    TextColor="#17212B"
                                                    IsPassword="True"
                                                    FontSize="15"
                                                    BackgroundColor="Transparent"
                                                    Margin="16,0,0,0"
                                                    HeightRequest="56"
                                                    ClearButtonVisibility="WhileEditing"
                                                    Completed="OnLoginCompleted" />
                                                <Button
                                                    x:Name="LoginToggleButton"
                                                    Grid.Column="1"
                                                    Text="Показать"
                                                    Style="{StaticResource InlineSmallButtonStyle}"
                                                    VerticalOptions="Center"
                                                    Clicked="OnToggleLoginPasswordClicked" />
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>
                                    <Button
                                        Text="Открыть хранилище"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Clicked="OnLoginClicked" />
                                    <Button
                                        Text="Сбросить пароль"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Clicked="OnGoResetClicked" />
                                </VerticalStackLayout>

                                <VerticalStackLayout x:Name="CreateBlock" IsVisible="False" Spacing="16">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="Новый пароль" Style="{StaticResource FieldLabelStyle}" />
                                        <Border Style="{StaticResource FieldBorderStyle}">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,0,8,0">
                                                <Entry
                                                    x:Name="CreatePasswordEntry"
                                                    Grid.Column="0"
                                                    Placeholder="Придумайте пароль"
                                                    PlaceholderColor="#8A98A3"
                                                    TextColor="#17212B"
                                                    IsPassword="True"
                                                    FontSize="15"
                                                    BackgroundColor="Transparent"
                                                    Margin="16,0,0,0"
                                                    HeightRequest="56"
                                                    ClearButtonVisibility="WhileEditing"
                                                    Completed="OnCreatePasswordCompleted" />
                                                <Button
                                                    x:Name="CreatePasswordToggleButton"
                                                    Grid.Column="1"
                                                    Text="Показать"
                                                    Style="{StaticResource InlineSmallButtonStyle}"
                                                    VerticalOptions="Center"
                                                    Clicked="OnToggleCreatePasswordClicked" />
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="Подтверждение пароля" Style="{StaticResource FieldLabelStyle}" />
                                        <Border Style="{StaticResource FieldBorderStyle}">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,0,8,0">
                                                <Entry
                                                    x:Name="CreateConfirmEntry"
                                                    Grid.Column="0"
                                                    Placeholder="Повторите пароль"
                                                    PlaceholderColor="#8A98A3"
                                                    TextColor="#17212B"
                                                    IsPassword="True"
                                                    FontSize="15"
                                                    BackgroundColor="Transparent"
                                                    Margin="16,0,0,0"
                                                    HeightRequest="56"
                                                    ClearButtonVisibility="WhileEditing"
                                                    Completed="OnCreateCompleted" />
                                                <Button
                                                    x:Name="CreateConfirmToggleButton"
                                                    Grid.Column="1"
                                                    Text="Показать"
                                                    Style="{StaticResource InlineSmallButtonStyle}"
                                                    VerticalOptions="Center"
                                                    Clicked="OnToggleCreateConfirmClicked" />
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>
                                    <Label
                                        Text="Минимальная длина пароля — 8 символов"
                                        Style="{StaticResource HintLabelStyle}" />
                                    <Button
                                        Text="Создать хранилище"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Clicked="OnCreateClicked" />
                                    <Button
                                        Text="Импортировать базу данных"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Clicked="OnImportClicked" />
                                    <Border
                                        x:Name="ImportPanel"
                                        Style="{StaticResource FieldBorderStyle}"
                                        Padding="16"
                                        IsVisible="False">
                                        <VerticalStackLayout Spacing="12">
                                            <Label Text="Приём базы данных" Style="{StaticResource FieldLabelStyle}" />
                                            <Label
                                                x:Name="ImportHintLabel"
                                                Text="На втором устройстве выберите передачу базы и укажите адрес этого устройства."
                                                Style="{StaticResource HintLabelStyle}" />
                                            <Label
                                                x:Name="ImportAddressLabel"
                                                FontSize="13"
                                                TextColor="#1C4E49" />
                                            <Button
                                                x:Name="SyncButton"
                                                Text="Принять базу с другого устройства"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Clicked="OnReceiveDatabaseClicked" />
                                            <Button
                                                x:Name="SyncCancelButton"
                                                Text="Отменить приём"
                                                Style="{StaticResource DangerButtonStyle}"
                                                IsVisible="False"
                                                Clicked="OnCancelSyncClicked" />
                                            <Border
                                                x:Name="SyncStatusContainer"
                                                IsVisible="False"
                                                StrokeThickness="0"
                                                BackgroundColor="#EEF8FF"
                                                StrokeShape="RoundRectangle 12"
                                                Padding="12,10">
                                                <Label
                                                    x:Name="SyncStatusLabel"
                                                    FontSize="13"
                                                    TextColor="#1D4ED8" />
                                            </Border>
                                        </VerticalStackLayout>
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout x:Name="ResetBlock" IsVisible="False" Spacing="16">
                                    <Button
                                        Text="← Назад ко входу"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Clicked="OnBackToLoginClicked" />
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="Новый пароль" Style="{StaticResource FieldLabelStyle}" />
                                        <Border Style="{StaticResource FieldBorderStyle}">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,0,8,0">
                                                <Entry
                                                    x:Name="ResetPasswordEntry"
                                                    Grid.Column="0"
                                                    Placeholder="Введите новый мастер-пароль"
                                                    PlaceholderColor="#8A98A3"
                                                    TextColor="#17212B"
                                                    IsPassword="True"
                                                    FontSize="15"
                                                    BackgroundColor="Transparent"
                                                    Margin="16,0,0,0"
                                                    HeightRequest="56"
                                                    ClearButtonVisibility="WhileEditing"
                                                    Completed="OnResetPasswordCompleted" />
                                                <Button
                                                    x:Name="ResetPasswordToggleButton"
                                                    Grid.Column="1"
                                                    Text="Показать"
                                                    Style="{StaticResource InlineSmallButtonStyle}"
                                                    VerticalOptions="Center"
                                                    Clicked="OnToggleResetPasswordClicked" />
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="Подтверждение нового пароля" Style="{StaticResource FieldLabelStyle}" />
                                        <Border Style="{StaticResource FieldBorderStyle}">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Padding="0,0,8,0">
                                                <Entry
                                                    x:Name="ResetConfirmEntry"
                                                    Grid.Column="0"
                                                    Placeholder="Повторите новый пароль"
                                                    PlaceholderColor="#8A98A3"
                                                    TextColor="#17212B"
                                                    IsPassword="True"
                                                    FontSize="15"
                                                    BackgroundColor="Transparent"
                                                    Margin="16,0,0,0"
                                                    HeightRequest="56"
                                                    ClearButtonVisibility="WhileEditing"
                                                    Completed="OnResetCompleted" />
                                                <Button
                                                    x:Name="ResetConfirmToggleButton"
                                                    Grid.Column="1"
                                                    Text="Показать"
                                                    Style="{StaticResource InlineSmallButtonStyle}"
                                                    VerticalOptions="Center"
                                                    Clicked="OnToggleResetConfirmClicked" />
                                            </Grid>
                                        </Border>
                                    </VerticalStackLayout>
                                    <Label
                                        Text="Минимальная длина пароля — 8 символов"
                                        Style="{StaticResource HintLabelStyle}" />
                                    <Button
                                        Text="Удалить старые данные"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Clicked="OnResetClicked" />
                                </VerticalStackLayout>

                                <Border
                                    x:Name="StatusContainer"
                                    IsVisible="False"
                                    StrokeThickness="0"
                                    BackgroundColor="#FFF2F2"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="14,12">
                                    <Label
                                        x:Name="StatusLabel"
                                        FontSize="13"
                                        TextColor="#C62828" />
                                </Border>

                                <Border
                                    x:Name="CapsLockContainer"
                                    IsVisible="False"
                                    StrokeThickness="0"
                                    BackgroundColor="#FFF7E8"
                                    StrokeShape="RoundRectangle 14"
                                    Padding="14,12">
                                    <Label
                                        Text="Caps Lock включён"
                                        FontSize="13"
                                        TextColor="#B26A00" />
                                </Border>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </Grid>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
