@page "/Settings"

<div class="screen">
    <!-- Top app bar -->
    <header class="appbar">
        <h1 class="appbar-title">Настройки</h1>
    </header>

    <!-- Content -->
    <main class="content">
        <!-- Смена пароля -->
        <section class="card">
            <div class="row" @onclick="OpenReplaceModal">
                <div class="row-left">
                    <span class="ico">
                        <img src="icons/lock.svg" alt="Сменить пароль" />
                    </span>
                    <span class="row-title">Сменить мастер‑пароль</span>
                </div>
            </div>
        </section>

<!-- Таймер автоблокировки -->
<div class="section-label">БЕЗОПАСНОСТЬ</div>
<section class="card">
    <div class="row timeout-row">
        <div class="row-left">
            <span class="ico">
                 <img src="icons/timer.svg" alt="Таймер" />
            </span>
            <span class="row-title">Блокировка</span>
        </div>
        
        <div class="custom-select" @onclick="ToggleDropdown">
            <div class="select-selected">
                @GetSelectedText()
            </div>
            @if (showDropdown)
            {
                <div class="select-items">
                    @foreach (var option in timeoutOptions)
                    {
                        <div class="select-item @(selectedTimeout == option.Value ? "selected" : "")" 
                             @onclick="() => SelectOption(option.Value)">
                            @option.Text
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</section>
        <!-- Очистка БД -->
        <section class="card">
            <div class="row" @onclick="OpenDeleteModal">
                <div class="row-left">
                    <span class="ico">
                         <img src="icons/delete.svg" alt="Очистить данные" />
                    </span>
                    <span class="row-title">Очистить все данные</span>
                </div>
            </div>
        </section>

        <div style="height: 16px;"></div>

        <!-- Перенос данных -->
        <section class="card">
            <div class="row" @onclick="SendUserToForm">
                <div class="row-left">
                    <span class="ico">
                        <img src="icons/sync.svg" alt="Перенести данные" />
                    </span>
                    <span class="row-title">Перенести данные</span>
                 </div>
             </div>
        </section>
    </main>
<!-- Модальное окно смены пароля -->
    @if (showReplaceModal)
    {
        <div class="modal-overlay" @onclick="CloseReplaceModal">
            <div class="modal-container" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h2>Смена мастер‑пароля</h2>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label>Текущий пароль</label>
                        <input type="password" class="form-control" @bind="currentPassword" placeholder="········" />
                    </div>
                    <div class="form-group">
                        <label>Новый пароль</label>
                        <input type="password" class="form-control" @bind="newPassword" placeholder="········" />
                    </div>
                    <div class="form-group">
                        <label>Подтверждение</label>
                        <input type="password" class="form-control" @bind="confirmPassword" placeholder="········" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" @onclick="ReplaceMasterPassword">
                        Подтвердить
                    </button>
                    <button class="btn btn-secondary" @onclick="CloseReplaceModal">
                        Отмена
                    </button>
                </div>
            </div>
        </div>
    }

    <!-- Модальное окно подтверждения очистки БД -->
    @if (showDeleteModal)
    {
        <div class="modal-overlay" @onclick="CloseDeleteModal">
            <div class="modal-container" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h2>Очистить базу данных</h2>
                </div>
                <div class="modal-body">
                    <p>Вы уверены? Все сохранённые пароли, карты и заметки будут безвозвратно удалены.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" style="background: #d32f2f;" @onclick="DeleteDatabase">
                        Удалить всё
                    </button>
                    <button class="btn btn-secondary" @onclick="CloseDeleteModal">
                        Отмена
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    // Состояния модальных окон
    private bool showReplaceModal = false;
    private bool showDeleteModal = false;

    // Поля формы смены пароля
    private string currentPassword = "";
    private string newPassword = "";
    private string confirmPassword = "";

    // Выбранное значение таймера (в секундах)
    private string selectedTimeout = "60"; // По умолчанию 1 минута

    // Методы смены пароля
    private void OpenReplaceModal()
    {
        showReplaceModal = true;
    }

    private void CloseReplaceModal()
    {
        showReplaceModal = false;
        currentPassword = "";
        newPassword = "";
        confirmPassword = "";
    }

    private void ReplaceMasterPassword()
    {
        // Смена пароля
        Console.WriteLine($"Смена пароля: текущий={currentPassword}, новый={newPassword}, подтверждение={confirmPassword}");
        CloseReplaceModal();
    }

    // Методы таймера
    private void OnTimeoutChanged(ChangeEventArgs e)
    {
        SetTimeLogout();
    }

    private void SetTimeLogout()
    {
        Console.WriteLine($"Таймер автоблокировки установлен на {selectedTimeout} секунд");
        // Установка таймера
    }

    // Методы очистки БД
    private void OpenDeleteModal()
    {
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
    }
    private void DeleteDatabase()
    {
        Console.WriteLine("База данных очищена");
        //  Очистка БД
        CloseDeleteModal();
    }

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    // Метод перенаправления на форму отправки
    private void SendUserToForm()
    {
        //Navigation.NavigateTo("/send");
    }

    private bool showDropdown = false;

private List<TimeoutOption> timeoutOptions = new List<TimeoutOption>
{
    new TimeoutOption { Value = "0", Text = "Никогда" },
    new TimeoutOption { Value = "30", Text = "30 сек" },
    new TimeoutOption { Value = "60", Text = "1 мин" },
    new TimeoutOption { Value = "120", Text = "2 мин" },
    new TimeoutOption { Value = "300", Text = "5 мин" },
    new TimeoutOption { Value = "600", Text = "10 мин" }
};

private class TimeoutOption
{
    public string Value { get; set; }
    public string Text { get; set; }
}

private void ToggleDropdown()
{
    showDropdown = !showDropdown;
}

private void SelectOption(string value)
{
    selectedTimeout = value;
    showDropdown = false;
}

private string GetSelectedText()
{
    var option = timeoutOptions.FirstOrDefault(o => o.Value == selectedTimeout);
    return option?.Text ?? "1 мин";
}

}

<style>
    .appbar
    {
        text-align:center;
    }

   /* Кастомный выпадающий список */
.custom-select {
    position: relative;
    width: 90px;
    cursor: pointer;
    z-index: 1000;
    flex-shrink: 0; 
    margin-left: auto; 
}

.select-selected {
    background: linear-gradient(180deg, rgba(255,255,255,0.25), rgba(255,255,255,0.1));
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 30px;
    padding: 8px 12px;
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    text-align: center;
    display: flex;
    align-items: center;
    justify-content: center;
}

.select-items {
    position: absolute;
    top: 110%;
    left: 0;
    right: 0;
    background: radial-gradient(circle at 15% 20%, rgba(255,255,255,.8), transparent 28%), 
                radial-gradient(circle at 85% 15%, rgba(120,255,220,.22), transparent 24%), 
                radial-gradient(circle at 70% 75%, rgba(120,190,255,.20), transparent 26%), 
                linear-gradient(160deg, var(--bg-1) 0%, var(--bg-2) 48%, var(--bg-3) 100%);
    backdrop-filter: blur(20px) saturate(160%);
    -webkit-backdrop-filter: blur(20px) saturate(160%);
    border: 1px solid rgba(255,255,255,0.3);
    border-radius: 20px;
    box-shadow: 0 8px 30px rgba(0,0,0,0.25), inset 0 1px 0 rgba(255,255,255,0.5);
    z-index: 10000;
    max-height: 220px;
    overflow-y: auto;
    padding: 6px 0;
}

.select-item {
    padding: 6px 16px;
    font-size: 13px;
    color: var(--text);
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: center;
    margin: 3px 6px;
    border-radius: 25px;
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
    border: 1px solid rgba(255,255,255,0.1);
    display: flex;
    align-items: center;
    justify-content: center;
}

.select-item:hover {
    background: var(--accent);
    color: white;
    transform: translateY(-1px);
    box-shadow: 0 4px 10px rgba(25, 163, 140, 0.3);
    border-color: rgba(255,255,255,0.3);
}

.select-item.selected {
    background: var(--label);
    color: white;
    font-weight: 600;
    box-shadow: inset 0 1px 0 rgba(255,255,255,0.3);
    border-color: rgba(255,255,255,0.3);
}

.select-items::-webkit-scrollbar {
    width: 6px;
}

.select-items::-webkit-scrollbar-track {
    background: rgba(255,255,255,0.1);
    border-radius: 10px;
    margin: 10px 0;
}

.select-items::-webkit-scrollbar-thumb {
    background: var(--accent);
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.2);
}

.select-items::-webkit-scrollbar-thumb:hover {
    background: var(--label);
}

section.card:has(.custom-select) {
    overflow: visible !important;
    z-index: 100;
}

.timeout-row {
    position: relative;
    z-index: 200;
}
</style>