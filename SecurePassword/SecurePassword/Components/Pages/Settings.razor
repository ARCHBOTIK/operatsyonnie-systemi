@page "/settings"
@using System.IO
@inject NavigationManager Navigation
@inject MasterPasswordService MasterPasswordService
@inject MasterPasswordPage MasterPasswordPage
@inject VaultSessionService VaultSession

<div class="screen">
    <header class="appbar">
        <h1 class="appbar-title">Настройки</h1>
    </header>

    <main class="content">
        <section class="card">
            <div class="row" @onclick="OpenReplaceModal">
                <div class="row-left">
                    <span class="ico">
                        <img src="/icons/lock.svg" alt="Сменить пароль" />
                    </span>
                    <span class="row-title">Сменить мастер-пароль</span>
                </div>
            </div>
        </section>

        <section class="card">
            <div class="card-content">
                <div class="row">
                    <div class="row-left">
                        <span class="ico">
                            <img src="/icons/shield.svg" alt="Блокировка" />
                        </span>
                        <span class="row-title">Автоблокировка</span>
                    </div>
                </div>

                <div class="divider"></div>

                <label class="toggle-row">
                    <div class="toggle-text">
                        <div class="toggle-label">При выходе из приложения</div>
                        <div class="toggle-hint">Следующий запуск потребует повторную авторизацию</div>
                    </div>
                    <span class="switch">
                        <input type="checkbox" checked="@VaultSession.LockOnExit" @onchange="ToggleLockOnExit" />
                        <span class="slider"></span>
                    </span>
                </label>

                <div class="divider"></div>

                <label class="toggle-row">
                    <div class="toggle-text">
                        <div class="toggle-label">При сворачивании</div>
                        <div class="toggle-hint">Скрытие окна возвращает на экран мастер-пароля</div>
                    </div>
                    <span class="switch">
                        <input type="checkbox" checked="@VaultSession.LockOnMinimize" @onchange="ToggleLockOnMinimize" />
                        <span class="slider"></span>
                    </span>
                </label>

                <div class="divider"></div>

                <label class="toggle-row timeout-row">
                    <div class="toggle-text">
                        <div class="toggle-label">Через 2 минуты бездействия</div>
                        <div class="toggle-hint">При отсутствии активности потребуется повторная авторизация</div>
                    </div>
                    <span class="switch">
                        <input type="checkbox" checked="@VaultSession.LockOnTimer" @onchange="ToggleLockTimer" />
                        <span class="slider"></span>
                    </span>
                </label>
            </div>
        </section>

        <section class="card">
            <div class="row" @onclick="LockApplication">
                <div class="row-left">
                    <span class="ico">
                        <img src="/icons/timer.svg" alt="Заблокировать" />
                    </span>
                    <span class="row-title">Заблокировать сейчас</span>
                </div>
            </div>
        </section>

        <section class="card">
            <div class="row" @onclick="OpenDeleteModal">
                <div class="row-left">
                    <span class="ico">
                        <img src="/icons/delete.svg" alt="Очистить данные" />
                    </span>
                    <span class="row-title">Очистить все данные</span>
                </div>
            </div>
        </section>

        <section class="card">
            <div class="row" @onclick="SendUserToForm">
                <div class="row-left">
                    <span class="ico">
                        <img src="/icons/sync.svg" alt="Перенести данные" />
                    </span>
                    <span class="row-title">Обмен данными</span>
                </div>
            </div>
        </section>
    </main>

    @if (showReplaceModal)
    {
        <div class="modal-overlay" @onclick="CloseReplaceModal">
            <div class="modal-container" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h2>Смена мастер-пароля</h2>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label>Текущий пароль</label>
                        <input type="password" class="form-control" @bind="currentPassword" placeholder="••••••••" />
                    </div>
                    <div class="form-group">
                        <label>Новый пароль</label>
                        <input type="password" class="form-control" @bind="newPassword" placeholder="••••••••" />
                    </div>
                    <div class="form-group">
                        <label>Подтверждение</label>
                        <input type="password" class="form-control" @bind="confirmPassword" placeholder="••••••••" />
                    </div>
                    @if (!string.IsNullOrWhiteSpace(replacePasswordError))
                    {
                        <p class="toggle-hint" style="color:#d32f2f;">@replacePasswordError</p>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-primary" @onclick="ReplaceMasterPassword">Подтвердить</button>
                    <button class="btn btn-secondary" @onclick="CloseReplaceModal">Отмена</button>
                </div>
            </div>
        </div>
    }

    @if (showDeleteModal)
    {
        <div class="modal-overlay" @onclick="CloseDeleteModal">
            <div class="modal-container" @onclick:stopPropagation="true">
                <div class="modal-header">
                    <h2>Очистить базу данных</h2>
                </div>
                <div class="modal-body">
                    <p>Все сохранённые пароли, карты и заметки будут безвозвратно удалены.</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-danger" @onclick="DeleteDatabase">Удалить всё</button>
                    <button class="btn btn-secondary" @onclick="CloseDeleteModal">Отмена</button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private static readonly string[] VaultFiles = ["keys.dat", "passwords.dat", "cards.dat", "notes.dat"];

    private bool showReplaceModal;
    private bool showDeleteModal;

    private string currentPassword = string.Empty;
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;
    private string replacePasswordError = string.Empty;

    private void ToggleLockOnExit(ChangeEventArgs _)
    {
        VaultSession.LockOnExit = !VaultSession.LockOnExit;
    }

    private void ToggleLockOnMinimize(ChangeEventArgs _)
    {
        VaultSession.LockOnMinimize = !VaultSession.LockOnMinimize;
    }

    private void ToggleLockTimer(ChangeEventArgs _)
    {
        VaultSession.LockOnTimer = !VaultSession.LockOnTimer;
    }

    private void OpenReplaceModal() => showReplaceModal = true;

    private void CloseReplaceModal()
    {
        showReplaceModal = false;
        currentPassword = string.Empty;
        newPassword = string.Empty;
        confirmPassword = string.Empty;
        replacePasswordError = string.Empty;
    }

    private void ReplaceMasterPassword()
    {
        replacePasswordError = string.Empty;

        if (string.IsNullOrWhiteSpace(currentPassword) ||
            string.IsNullOrWhiteSpace(newPassword) ||
            string.IsNullOrWhiteSpace(confirmPassword))
        {
            replacePasswordError = "Заполните все поля.";
            return;
        }

        if (newPassword != confirmPassword)
        {
            replacePasswordError = "Новый пароль и подтверждение не совпадают.";
            return;
        }

        try
        {
            MasterPasswordService.ChangeMasterPassword(currentPassword, newPassword);
            CloseReplaceModal();
        }
        catch
        {
            replacePasswordError = "Не удалось сменить мастер-пароль. Проверьте текущий пароль.";
        }
    }

    private void OpenDeleteModal() => showDeleteModal = true;
    private void CloseDeleteModal() => showDeleteModal = false;

    private void DeleteDatabase()
    {
        foreach (string file in VaultFiles)
        {
            string filePath = Path.Combine(FileSystem.AppDataDirectory, file);
            if (File.Exists(filePath))
                File.Delete(filePath);
        }

        CloseDeleteModal();
        LockApplication();
    }

    private void SendUserToForm()
    {
        Navigation.NavigateTo("/syncauth");
    }

    private void LockApplication()
    {
        Navigation.NavigateTo("/");
        MasterPasswordPage.PrepareForLock();
    }
}
