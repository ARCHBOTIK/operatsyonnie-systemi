@page "/"

<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Мой сейф</title>
    <link rel="stylesheet" href="styles.css" />
</head>
<body>
    <div class="screen">

            <header class="appbar">
                <div class="appbar-left">
                    <button class="icon-button" @onclick="ToggleSort">
                        <img src="icons/sort.svg" />
                    </button>
                </div>

                <div class="appbar-right">
                    <img src="icons/search.svg" class="icon" />
                </div>
            </header>

        <!-- Content -->
        <main class="content">
            <!-- ФОРМА ДОБАВЛЕНИЯ -->
            @if (showAddForm)
            {
                <div class="modal-overlay" @onclick="SetFormState">
                    <div class="modal-container" @onclick:stopPropagation="true">
                        <div class="modal-header">
                            <h2>Добавление нового элемента</h2>
                        </div>

                        <div class="modal-body">
                            <div class="form-group">
                                <label>Тип элемента:</label>
                                <div class="type-selector">
                                    <button class="@(selectedType == ItemType.Password ? "active" : "")" @onclick="() => selectedType = ItemType.Password">
                                        <img src="icons/login.png" alt="Пароль" />
                                        <span>Пароль</span>
                                    </button>
                                    <button class="@(selectedType == ItemType.Card ? "active" : "")" @onclick="() => selectedType = ItemType.Card">
                                        <img src="icons/card.png" alt="Карта" />
                                        <span>Карта</span>
                                    </button>
                                    <button class="@(selectedType == ItemType.Note ? "active" : "")" @onclick="() => selectedType = ItemType.Note">
                                        <img src="icons/secure_note.png" alt="Заметка" />
                                        <span>Заметка</span>
                                    </button>
                                </div>
                            </div>

                            @if (selectedType == ItemType.Password)
                            {
                                <div class="password-form">
                                    <div class="form-group">
                                        <label for="title">Название</label>
                                        <input type="text" id="title" class="form-control" @bind="title" placeholder="Название" />
                                    </div>
                                    <div class="form-group">
                                        <label for="login">Логин</label>
                                        <input type="text" id="login" class="form-control" @bind="login" placeholder="ivan.ivanov@mail.ru" />
                                    </div>
                                    <div class="form-group">
                                        <label for="password">Пароль</label>
                                        <input type="password" id="password" class="form-control" @bind="password" placeholder="········" maxlength="100" />
                                    </div>
                                </div>
                            }

                            @if (selectedType == ItemType.Card)
                            {
                                <div class="card-form">

                                    <!-- CARD INPUT SURFACE -->
                                    <div class="card-input"
                                         tabindex="0"
                                         @onclick="() => FocusField(CardField.Number)">

                                        <div class="card-chip"></div>

                                        <div class="card-line">
                                            <div class="card-label">Номер</div>
                                            <div class="card-value card-value-mono @( _activeField == CardField.Number ? "is-active" : "" )">
                                                @(string.IsNullOrWhiteSpace(cardNumber) ? "1234 5678 9012 3456" : cardNumber)
                                            </div>
                                        </div>

                                        <div class="card-grid">
                                            <div class="card-line" @onclick:stopPropagation="true" @onclick="() => FocusField(CardField.Holder)">
                                                <div class="card-label">Владелец</div>
                                                <div class="card-value @( _activeField == CardField.Holder ? "is-active" : "" )">
                                                    @(string.IsNullOrWhiteSpace(cardHolder) ? "IVAN IVANOV" : cardHolder.ToUpperInvariant())
                                                </div>
                                            </div>

                                            <div class="card-line" @onclick:stopPropagation="true" @onclick="() => FocusField(CardField.Exp)">
                                                <div class="card-label">Срок</div>
                                                <div class="card-value card-value-mono @( _activeField == CardField.Exp ? "is-active" : "" )">
                                                    @(string.IsNullOrWhiteSpace(expiryDate) ? "MM/YY" : expiryDate)
                                                </div>
                                            </div>

                                            <div class="card-line" @onclick:stopPropagation="true" @onclick="() => FocusField(CardField.Cvv)">
                                                <div class="card-label">CVV</div>
                                                <div class="card-value card-value-mono @( _activeField == CardField.Cvv ? "is-active" : "" )">
                                                    @(string.IsNullOrWhiteSpace(cvv) ? "•••" : new string('•', cvv.Length))
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Минимальные поля (можно оставить, можно спрятать визуально) -->
                                    <div class="card-hidden-inputs">
                                        <input id="cardNumberInput"
                                               class="form-control"
                                               inputmode="numeric"
                                               autocomplete="cc-number"
                                               maxlength="19"
                                               value="@cardNumber"
                                               @oninput="OnCardNumberInput" />

                                        <input id="cardHolderInput"
                                               class="form-control"
                                               autocomplete="cc-name"
                                               value="@cardHolder"
                                               @oninput="OnCardHolderInput" />

                                        <div class="form-row">
                                            <input id="expiryInput"
                                                   class="form-control"
                                                   inputmode="numeric"
                                                   autocomplete="cc-exp"
                                                   maxlength="5"
                                                   value="@expiryDate"
                                                   @oninput="OnExpiryInput" />

                                            <input id="cvvInput"
                                                   class="form-control"
                                                   inputmode="numeric"
                                                   autocomplete="cc-csc"
                                                   maxlength="3"
                                                   value="@cvv"
                                                   @oninput="OnCvvInput" />
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label for="title">Название карты</label>
                                        <input type="text" id="title" class="form-control" @bind="title" placeholder="Например: Зарплатная" />
                                    </div>
                                </div>
                            }

                            @if (selectedType == ItemType.Note)
                            {
                                <div class="note-form">
                                    <div class="form-group">
                                        <label for="noteTitle">Название заметки</label>
                                        <input type="text" id="noteTitle" class="form-control" @bind="noteTitle" placeholder="Важные мысли" />
                                    </div>
                                    <div class="form-group">
                                        <label for="noteContent">Содержание</label>
                                        <textarea id="noteContent" class="form-control note-textarea" @bind="noteContent" rows="8" placeholder="Введите текст заметки..."></textarea>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="modal-footer">
                            <button class="btn btn-primary" @onclick="SaveItem">
                                <img src="icons/plus.png" alt="Сохранить" />
                                <span>Сохранить</span>
                            </button>
                            <button class="btn btn-secondary" @onclick="SetFormState">
                                Отмена
                            </button>
                        </div>
                    </div>
                </div>
            }

            <!-- Логины -->
            <section class="card">
                <div class="row" @onclick="() => ToggleCategory(0)">
                    <div class="row-left">
                        <span class="ico">
                            <img src="icons/login.png" alt="Логины" />
                        </span>
                        <span class="row-title">Логины</span>
                    </div>
                    <div>
                        <span class="row-right">@PasswordRepository.getAll().Count()</span>
                        <span> @(expandedIndex == 0 && PasswordRepository.getAll().Count()!=0 ? "▼" : "▶")</span>
                    </div>
                </div>
                
                @if (expandedIndex == 0)
                {
                    <div>
                        @foreach(var i in PasswordRepository.getAll())
                        {
                            <div class="divider"></div>
                            <!-- Вывод полей из БД паролей -->
                            <div class="row">
                                <div class="row-left">
                                    <span class="brand">
                                        <img src=@ServiceImageGenerator.GetServiceIconPath(i.ServiceName) alt=@i.Title width="40" height="40" />
                                    </span>
                                    <div class="row-text">
                                        <div class="row-title">@i.Title</div>
                                        <div class="row-sub">@i.Login</div>
                                    </div>
                                </div>
                                <button class="kebab" aria-label="Действия">
                                    <span></span><span></span><span></span>
                                </button>
                            </div>
                        }
                    </div>
                }
            </section>

            <!-- Карты (только СберБанк) -->
            <section class="card">
                <div class="row" @onclick="() => ToggleCategory(1)">
                    <div class="row-left">
                        <span class="ico">
                            <img src="icons/card.png" alt="Карты" />
                        </span>
                        <span class="row-title">Карты</span>
                    </div>
                    <div>
                        <span class="row-right">@CardRepository.getAll().Count()</span>
                        <span> @(expandedIndex == 1 && CardRepository.getAll().Count() != 0 ? "▼" : "▶")</span>
                    </div>
                </div>
                
                @if (expandedIndex == 1)
                {
                    <div>
                        @foreach (var i in CardRepository.getAll())
                        {
                            <div class="divider"></div>
                            <div class="row">
                                <div class="row-left">
                                    <span class="brand">
                                        <img src=@ServiceImageGenerator.GetServiceIconPath(i.BankName) alt=@i.Title width="40" height="40" />
                                    </span>
                                    <div class="row-text">
                                        <div class="row-title">СберБанк</div>
                                        <div class="row-sub">i.ivanov@mail.ru</div>
                                    </div>
                                </div>
                                <button class="kebab" aria-label="Действия">
                                    <span></span><span></span><span></span>
                                </button>
                            </div>
                        }
                    </div>
                }
            </section>

         

            <!-- Защищённая заметка -->
            <section class="card">
                <div class="row" @onclick="() => ToggleCategory(2)">
                    <div class="row-left">
                        <span class="ico">
                            <img src="icons/note.png" alt="Защищённая заметка" />
                        </span>
                        <span class="row-title">Защищённая заметка</span>
                    </div>
                    <div>
                        <span class="row-right">@NoteRepository.getAll().Count()</span>
                        <span> @(expandedIndex == 2 && NoteRepository.getAll().Count() != 0 ? "▼" : "▶")</span>
                    </div>
                </div>
                
                @if (expandedIndex == 2)
                {
                    <div>
                        @foreach (var i in NoteRepository.getAll())
                        {
                            <div class="divider"></div>
                            <div class="row">
                                <span style="margin: 0 auto; color: #999;">Нет данных</span>
                            </div>
                        }
                    </div>
                }
            </section>

            <!-- Floating action button -->
            <button class="fab" aria-label="Добавить" @onclick="SetFormState">
                <img src="icons/plus.png" alt="Добавить" />
            </button>
        </main>
    </div>
</body>
</html>

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private SecureRepository<PasswordEntry> PasswordRepository { get; set; }
    [Inject] private SecureRepository<CardEntry> CardRepository { get; set; }
    [Inject] private SecureRepository<NoteEntry> NoteRepository { get; set; }


    private List<PasswordEntry> passwords = new();
    private List<CardEntry> cards = new();
    private List<NoteEntry> notes = new();

    private enum CardField { Number, Holder, Exp, Cvv }
    private CardField _activeField = CardField.Number;

    private enum PageType
    {
        Safe,
        Send,
        Generator,
        Settings
    }

    private enum ItemType { Password, Card, Note }
    private ItemType selectedType = ItemType.Password;

    // Поля для форм
    private string title = "";
    private string login = "";
    private string password = "";
    // Поля для карт
    private string cardNumber = "";
    private string cardHolder = "";
    private string expiryDate = "";
    private string cvv = "";
    private string cardTitle = "";
    // Поля для заметок
    private string noteTitle = "";
    private string noteContent = "";

    private int expandedIndex = 0; // 0-логины, 1-карты, 2-заметки
    private bool showAddForm = false;

    private PageType currentPage = PageType.Safe;

    private string GetPageTitle()
    {
        return currentPage switch
        {
            PageType.Safe => "Мой сейф",
            PageType.Send => "Отправка",
            PageType.Generator => "Генератор",
            PageType.Settings => "Настройки",
            _ => "Мой сейф"
        };
    }

    protected override void OnInitialized()
    {
        LoadData();
    }

    private void LoadData()
    {
        try
        {
            passwords = PasswordRepository.getAll().ToList();
            cards = CardRepository.getAll().ToList();
            notes = NoteRepository.getAll().ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading data: {ex.Message}");
        }
    }

    private void NavigateTo(PageType page)
    {
        currentPage = page;
    }

    private async Task FocusField(CardField f)
    {
        _activeField = f;

        var id = f switch
        {
            CardField.Number => "cardNumberInput",
            CardField.Holder => "cardHolderInput",
            CardField.Exp => "expiryInput",
            CardField.Cvv => "cvvInput",
            _ => "cardNumberInput"
        };

        await JS.InvokeVoidAsync("bpFocus", id);
    }

    private void ToggleSort() { } //логика сортировки


    private void OnCardNumberInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "";
        var digits = new string(raw.Where(char.IsDigit).ToArray());
        if (digits.Length > 16) digits = digits[..16];

        cardNumber = string.Join(" ", Enumerable.Range(0, (digits.Length + 3) / 4)
            .Select(i => digits.Skip(i * 4).Take(4))
            .Where(g => g.Any())
            .Select(g => new string(g.ToArray())));
    }

    private void OnCardHolderInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "";
        // Можно оставить любые символы, но часто делают латиницу + пробел
        cardHolder = raw.Trim();
    }

    private void OnCvvInput(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString() ?? "";
        var digits = new string(raw.Where(char.IsDigit).ToArray());
        if (digits.Length > 3) digits = digits[..3];
        cvv = digits;
    }

    private void OnExpiryInput(ChangeEventArgs e)
    {
        var raw = (e.Value?.ToString() ?? "");
        var digits = new string(raw.Where(char.IsDigit).ToArray());
        if (digits.Length > 4) digits = digits[..4];

        expiryDate = digits.Length switch
        {
            <= 2 => digits,
            _ => digits[..2] + "/" + digits[2..]
        };
    }

    private void ToggleCategory(int index)
    {
        if (expandedIndex == index)
            expandedIndex = -1; // сворачиваем
        else
            expandedIndex = index; // разворачиваем выбранную
    }

    private void SetFormState()
    {
        
        showAddForm = showAddForm?false:true;
        selectedType = ItemType.Password;
    }

    
    private void ClearForm()
    {
        title = "";
        login = "";
        password = "";
        cardNumber = "";
        cardHolder = "";
        expiryDate = "";
        cvv = "";
        noteTitle = "";
        noteContent = "";
    }

    private int GetNextId<T>(List<T> items) where T : IHasID
    {
        return items.Any() ? items.Max(x => x.Id) + 1 : 1;
    }

    private async Task SaveItem()
    {
        try
        {
            switch (selectedType)
            {
                case ItemType.Password:
                    var newPassword = new PasswordEntry
                    {
                        Id = GetNextId(passwords),
                        Title = title,
                        Login = login,
                        Password = password
                    };
                    
                    PasswordRepository.Add(newPassword);
                    PasswordRepository.Save();
                    passwords = PasswordRepository.getAll().ToList();
                    break;

                case ItemType.Card:
                    var newCard = new CardEntry
                    {
                        Id = GetNextId(cards),
                        Title = cardTitle,
                        CardNumber = cardNumber.Replace(" ", ""),
                        CardHolder = cardHolder,
                        ExpiryDate = expiryDate,
                        Cvv = cvv
                    };
                    
                    CardRepository.Add(newCard);
                    CardRepository.Save();
                    cards = CardRepository.getAll().ToList();
                    break;

                case ItemType.Note:
                    var newNote = new NoteEntry
                    {
                        Id = GetNextId(notes),
                        Title = noteTitle,
                        Content = noteContent
                    };
                    
                    NoteRepository.Add(newNote);
                    NoteRepository.Save();
                    notes = NoteRepository.getAll().ToList();
                    break;
            }

            ClearForm();
            showAddForm = false;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error saving item: {ex.Message}");
        }
    }
}