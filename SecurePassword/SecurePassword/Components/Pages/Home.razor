@page "/"
@implements IDisposable

<div class="screen">
    <header class="appbar">
        <div class="appbar-left">
            <button class="icon-button" @onclick="ToggleSort" title="Сортировка">
                <img src="@GetSortIcon()" alt="Сортировка" />
            </button>
        </div>

        <div class="appbar-right">
            <div class="search-wrapper @(isSearchExpanded ? "expanded" : "")">
                <input type="text"
                       class="search-input"
                       placeholder="Поиск..."
                       value="@searchQuery"
                       @oninput="OnSearchInput"
                       @onkeypress="OnSearchKeyPress"
                       @onblur="OnSearchBlur" />
                @if (!string.IsNullOrEmpty(searchQuery))
                {
                    <button class="search-clear" @onclick="ClearSearch">
                        <img src="/icons/close.svg" alt="Очистить" />
                    </button>
                }
            </div>
            <button class="icon-button" @onclick="ToggleSearch">
                <img src="/icons/search.svg" alt="Поиск" />
            </button>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(searchQuery))
    {
        <div class="search-results-inline">
            @if (GetFilteredItemsCount() > 0)
            {
                <div class="sort-indicator">
                    Сортировка: @(sortBy == "title" ? "по названию" : "по типу")
                    @(sortDescending ? "▼" : "▲")
                </div>
            }

            <div class="search-header-inline">
                <span>Найдено: @GetFilteredItemsCount()</span>
            </div>

            <div class="search-filters-inline">
                <button class="filter-chip @(activeFilter == "all" ? "active" : "")" @onclick="@(() => SetFilter("all"))">Все</button>
                <button class="filter-chip @(activeFilter == "password" ? "active" : "")" @onclick="@(() => SetFilter("password"))">Пароли</button>
                <button class="filter-chip @(activeFilter == "card" ? "active" : "")" @onclick="@(() => SetFilter("card"))">Карты</button>
                <button class="filter-chip @(activeFilter == "note" ? "active" : "")" @onclick="@(() => SetFilter("note"))">Заметки</button>
            </div>

            <div class="search-results-list-inline">
                @foreach (var item in GetFilteredItemsSorted())
                {
                    <div class="search-result-item-inline card" @onclick="@(() => SelectSearchResult(item))">
                        <div class="row-left">
                            <span class="ico">
                                <img src="@GetItemIcon(item)" alt="@item.Type" />
                            </span>
                            <div class="row-text">
                                <div class="row-title">@item.Title</div>
                                <div class="row-sub">@item.Subtitle</div>
                            </div>
                        </div>
                        <div class="result-badge">@GetItemTypeName(item.Type)</div>
                    </div>
                }

                @if (!GetFilteredItems().Any())
                {
                    <div class="no-results-inline">
                        <p>Ничего не найдено</p>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <main class="content">
            @if (showAddForm)
            {
                <div class="modal-overlay" @onclick="CloseForm">
                    <div class="modal-container" @onclick:stopPropagation="true">
                        <div class="modal-header">
                            <h2>@(isEditMode ? "Редактирование элемента" : "Добавление нового элемента")</h2>
                        </div>

                        <div class="modal-body">
                            <div class="form-group">
                                <label>Тип элемента</label>
                                <div class="type-selector">
                                    <button class="@(selectedType == ItemType.Password ? "active" : "")"
                                            @onclick="@(() => SelectType(ItemType.Password))"
                                            disabled="@isEditMode">
                                        <img src="/icons/login.svg" alt="Пароль" />
                                        <span>Пароль</span>
                                    </button>

                                    <button class="@(selectedType == ItemType.Card ? "active" : "")"
                                            @onclick="@(() => SelectType(ItemType.Card))"
                                            disabled="@isEditMode">
                                        <img src="/icons/card.svg" alt="Карта" />
                                        <span>Карта</span>
                                    </button>

                                    <button class="@(selectedType == ItemType.Note ? "active" : "")"
                                            @onclick="@(() => SelectType(ItemType.Note))"
                                            disabled="@isEditMode">
                                        <img src="/icons/note.svg" alt="Заметка" />
                                        <span>Заметка</span>
                                    </button>
                                </div>
                            </div>

                            @if (selectedType == ItemType.Password)
                            {
                                <div class="password-form">
                                    <div class="form-group">
                                        <label for="serviceName">Сервис или сайт</label>
                                        <input type="text" id="serviceName" class="form-control" @bind="serviceName" placeholder="Например: GitHub" />
                                    </div>

                                    <div class="form-group">
                                        <label for="passwordTitle">Название</label>
                                        <input type="text" id="passwordTitle" class="form-control" @bind="title" placeholder="Рабочий аккаунт" />
                                    </div>

                                    <div class="form-group">
                                        <label for="login">Логин</label>
                                        <input type="text" id="login" class="form-control" @bind="login" placeholder="ivan.ivanov@mail.ru" />
                                    </div>

                                    <div class="form-group">
                                        <label for="password">Пароль</label>
                                        <input type="password" id="password" class="form-control" @bind="password" placeholder="••••••••" maxlength="100" />
                                    </div>
                                </div>
                            }

                            @if (selectedType == ItemType.Card)
                            {
                                <div class="card-form">
                                    <div class="card-input"
                                         tabindex="0"
                                         @onclick="@(() => FocusField(CardField.Number))">

                                        <div class="card-chip"></div>

                                        <div class="card-line">
                                            <div class="card-label">Номер</div>
                                            <div class="card-value card-value-mono @(_activeField == CardField.Number ? "is-active" : "")">
                                                @(string.IsNullOrWhiteSpace(cardNumber) ? "1234 5678 9012 3456" : cardNumber)
                                            </div>
                                        </div>

                                        <div class="card-grid">
                                            <div class="card-line" @onclick:stopPropagation="true" @onclick="@(() => FocusField(CardField.Holder))">
                                                <div class="card-label">Владелец</div>
                                                <div class="card-value @(_activeField == CardField.Holder ? "is-active" : "")">
                                                    @(string.IsNullOrWhiteSpace(cardHolder) ? "IVAN IVANOV" : cardHolder.ToUpperInvariant())
                                                </div>
                                            </div>

                                            <div class="card-line" @onclick:stopPropagation="true" @onclick="@(() => FocusField(CardField.Exp))">
                                                <div class="card-label">Срок</div>
                                                <div class="card-value card-value-mono @(_activeField == CardField.Exp ? "is-active" : "")">
                                                    @(string.IsNullOrWhiteSpace(expiryDate) ? "MM/YY" : expiryDate)
                                                </div>
                                            </div>

                                            <div class="card-line" @onclick:stopPropagation="true" @onclick="@(() => FocusField(CardField.Cvv))">
                                                <div class="card-label">CVV</div>
                                                <div class="card-value card-value-mono @(_activeField == CardField.Cvv ? "is-active" : "")">
                                                    @(string.IsNullOrWhiteSpace(cvv) ? "•••" : new string('•', cvv.Length))
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="card-hidden-inputs">
                                        <input id="cardNumberInput" class="form-control" inputmode="numeric" autocomplete="cc-number" maxlength="19" value="@cardNumber" @oninput="OnCardNumberInput" />
                                        <input id="cardHolderInput" class="form-control" autocomplete="cc-name" value="@cardHolder" @oninput="OnCardHolderInput" />
                                        <div class="form-row">
                                            <input id="expiryInput" class="form-control" inputmode="numeric" autocomplete="cc-exp" maxlength="5" value="@expiryDate" @oninput="OnExpiryInput" />
                                            <input id="cvvInput" class="form-control" inputmode="numeric" autocomplete="cc-csc" maxlength="3" value="@cvv" @oninput="OnCvvInput" />
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label for="cardTitle">Название карты</label>
                                        <input type="text" id="cardTitle" class="form-control" @bind="cardTitle" placeholder="Например: Зарплатная" />
                                    </div>
                                </div>
                            }

                            @if (selectedType == ItemType.Note)
                            {
                                <div class="note-form">
                                    <div class="note-form-header">
                                        <img src="/icons/note.svg" alt="Заметка" />
                                        <span>Защищённая заметка</span>
                                    </div>

                                    <div class="form-group">
                                        <label for="noteTitle">Название заметки</label>
                                        <input type="text" id="noteTitle" class="form-control" @bind="noteTitle" placeholder="Важные мысли" />
                                    </div>

                                    <div class="form-group">
                                        <label for="noteContent">Содержание</label>
                                        <textarea id="noteContent" class="form-control note-textarea" @bind="noteContent" rows="8" placeholder="Введите текст заметки..."></textarea>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="modal-footer">
                            <button class="btn btn-primary" @onclick="SaveItem">
                                <img src="/icons/plus.svg" alt="Сохранить" />
                                <span>@(isEditMode ? "Сохранить изменения" : "Сохранить")</span>
                            </button>
                            <button class="btn btn-secondary" @onclick="CloseForm">Отмена</button>
                        </div>
                    </div>
                </div>
            }

            @if (showDetail)
            {
                <div class="modal-overlay" @onclick="CloseDetail">
                    <div class="detail-container" @onclick:stopPropagation="true">
                        <div class="detail-header">
                            <div class="detail-icon">
                                <img src="@GetDetailIcon()" alt="Иконка" />
                            </div>
                            <h2>@detailTitle</h2>
                            <button class="close-button" @onclick="CloseDetail">
                                <img src="/icons/close.svg" alt="Закрыть" />
                            </button>
                        </div>

                        <div class="detail-body">
                            @if (currentDetailType == "password")
                            {
                                <div class="detail-field">
                                    <label>Название</label>
                                    <div class="field-value">@detailTitle</div>
                                </div>
                                <div class="detail-field">
                                    <label>Логин</label>
                                    <div class="field-value">@detailLogin</div>
                                </div>
                                <div class="detail-field">
                                    <label>Пароль</label>
                                    <div class="field-value password-field">
                                        <span>@(showPassword ? detailPassword : "••••••••")</span>
                                        <button class="icon-button-small" @onclick="TogglePasswordVisibility">
                                            <img src="@(showPassword ? "/icons/eye-off.svg" : "/icons/eye.svg")" alt="Видимость пароля" />
                                        </button>
                                    </div>
                                </div>
                            }
                            else if (currentDetailType == "card")
                            {
                                <div class="detail-field">
                                    <label>Название карты</label>
                                    <div class="field-value">@detailTitle</div>
                                </div>
                                <div class="detail-field">
                                    <label>Номер карты</label>
                                    <div class="field-value">@detailCardNumber</div>
                                </div>
                                <div class="detail-field">
                                    <label>Владелец</label>
                                    <div class="field-value">@detailCardHolder</div>
                                </div>
                                <div class="detail-row">
                                    <div class="detail-field">
                                        <label>Срок</label>
                                        <div class="field-value">@detailExpiryDate</div>
                                    </div>
                                    <div class="detail-field">
                                        <label>CVV</label>
                                        <div class="field-value password-field">
                                            <span>@(showCvv ? detailCvv : "•••")</span>
                                            <button class="icon-button-small" @onclick="ToggleCvvVisibility">
                                                <img src="@(showCvv ? "/icons/eye-off.svg" : "/icons/eye.svg")" alt="Видимость CVV" />
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                            else if (currentDetailType == "note")
                            {
                                <div class="detail-field">
                                    <label>Название заметки</label>
                                    <div class="field-value">@detailTitle</div>
                                </div>
                                <div class="detail-field">
                                    <label>Содержание</label>
                                    <div class="field-value note-content">@detailContent</div>
                                </div>
                            }
                        </div>

                        <div class="detail-footer">
                            <button class="btn btn-secondary" @onclick="EditItem">
                                <img src="/icons/edit.svg" alt="Редактировать" />
                                <span>Редактировать</span>
                            </button>
                            <button class="btn btn-danger" @onclick="DeleteItem">
                                <img src="/icons/delete.svg" alt="Удалить" />
                                <span>Удалить</span>
                            </button>
                        </div>
                    </div>
                </div>
            }

            <section class="card">
                <div class="row" @onclick="@(() => ToggleCategory(0))">
                    <div class="row-left">
                        <span class="ico"><img src="/icons/login.svg" alt="Логины" /></span>
                        <span class="row-title">Логины</span>
                    </div>
                    <div>
                        <span class="row-right">@passwords.Count</span>
                        <span>@(expandedIndex == 0 ? "▼" : "▶")</span>
                    </div>
                </div>

                @if (expandedIndex == 0)
                {
                    @if (passwords.Count == 0)
                    {
                        <div class="divider"></div>
                        <div class="row"><span style="margin: 0 auto; color: #999;">Нет данных</span></div>
                    }
                    else
                    {
                        @foreach (var item in passwords)
                        {
                            <div class="divider"></div>
                            <div class="row">
                                <div class="row-left" @onclick="@(() => ShowPasswordDetail(item))">
                                    <span class="brand">
                                        <img src="@GetServiceIconPathForUi(item.ServiceName, item.Title)" alt="@item.Title" width="40" height="40" />
                                    </span>
                                    <div class="row-text">
                                        <div class="row-title">@item.Title</div>
                                        <div class="row-sub">@item.Login</div>
                                    </div>
                                </div>
                                <button class="kebab" aria-label="Действия" @onclick="(() => ShowPasswordDetail(item))" @onclick:stopPropagation="true">
                                    <span></span><span></span><span></span>
                                </button>
                            </div>
                        }
                    }
                }
            </section>

            <section class="card">
                <div class="row" @onclick="@(() => ToggleCategory(1))">
                    <div class="row-left">
                        <span class="ico"><img src="/icons/card.svg" alt="Карты" /></span>
                        <span class="row-title">Карты</span>
                    </div>
                    <div>
                        <span class="row-right">@cards.Count</span>
                        <span>@(expandedIndex == 1 ? "▼" : "▶")</span>
                    </div>
                </div>

                @if (expandedIndex == 1)
                {
                    @if (cards.Count == 0)
                    {
                        <div class="divider"></div>
                        <div class="row"><span style="margin: 0 auto; color: #999;">Нет данных</span></div>
                    }
                    else
                    {
                        @foreach (var item in cards)
                        {
                            <div class="divider"></div>
                            <div class="row">
                                <div class="row-left" @onclick="@(() => ShowCardDetail(item))">
                                    <span class="brand">
                                        <img src="/icons/card.svg" alt="@item.Title" width="40" height="40" />
                                    </span>
                                    <div class="row-text">
                                        <div class="row-title">@item.Title</div>
                                        <div class="row-sub">@MaskCardNumber(item.CardNumber)</div>
                                    </div>
                                </div>
                                <button class="kebab" aria-label="Действия" @onclick="(() => ShowCardDetail(item))" @onclick:stopPropagation="true">
                                    <span></span><span></span><span></span>
                                </button>
                            </div>
                        }
                    }
                }
            </section>

            <section class="card">
                <div class="row" @onclick="@(() => ToggleCategory(2))">
                    <div class="row-left">
                        <span class="ico"><img src="/icons/note.svg" alt="Защищённые заметки" /></span>
                        <span class="row-title">Защищённые заметки</span>
                    </div>
                    <div>
                        <span class="row-right">@notes.Count</span>
                        <span>@(expandedIndex == 2 ? "▼" : "▶")</span>
                    </div>
                </div>

                @if (expandedIndex == 2)
                {
                    @if (notes.Count == 0)
                    {
                        <div class="divider"></div>
                        <div class="row"><span style="margin: 0 auto; color: #999;">Нет данных</span></div>
                    }
                    else
                    {
                        @foreach (var item in notes)
                        {
                            <div class="divider"></div>
                            <div class="row">
                                <div class="row-left" @onclick="@(() => ShowNoteDetail(item))">
                                    <span class="brand">
                                        <img src="/icons/note.svg" alt="@item.Title" width="40" height="40" />
                                    </span>
                                    <div class="row-text">
                                        <div class="row-title">@item.Title</div>
                                        <div class="row-sub">@GetNotePreview(item.Content)</div>
                                    </div>
                                </div>
                                <button class="kebab" aria-label="Действия" @onclick="(() => ShowNoteDetail(item))" @onclick:stopPropagation="true">
                                    <span></span><span></span><span></span>
                                </button>
                            </div>
                        }
                    }
                }
            </section>

            <div class="fab-container">
                <button class="fab" @onclick="OpenAddForm" aria-label="Добавить">
                    <img src="/icons/plus.svg" alt="Добавить" />
                </button>
            </div>
        </main>
    }
</div>

@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private VaultSessionService VaultSession { get; set; } = default!;
    [Inject] private SecureRepository<PasswordEntry> PasswordRepository { get; set; } = default!;
    [Inject] private SecureRepository<CardEntry> CardRepository { get; set; } = default!;
    [Inject] private SecureRepository<NoteEntry> NoteRepository { get; set; } = default!;

    private List<PasswordEntry> passwords = [];
    private List<CardEntry> cards = [];
    private List<NoteEntry> notes = [];

    private enum CardField { Number, Holder, Exp, Cvv }
    private enum ItemType { Password, Card, Note }

    private CardField _activeField = CardField.Number;
    private ItemType selectedType = ItemType.Password;

    private string title = string.Empty;
    private string login = string.Empty;
    private string password = string.Empty;
    private string serviceName = string.Empty;
    private string cardNumber = string.Empty;
    private string cardHolder = string.Empty;
    private string expiryDate = string.Empty;
    private string cvv = string.Empty;
    private string cardTitle = string.Empty;
    private string noteTitle = string.Empty;
    private string noteContent = string.Empty;

    private int expandedIndex;
    private bool showAddForm;
    private bool isEditMode;

    private string searchQuery = string.Empty;
    private bool isSearchExpanded;
    private string activeFilter = "all";
    private string sortBy = "title";
    private bool sortDescending;

    private bool showDetail;
    private string currentDetailType = string.Empty;
    private string detailTitle = string.Empty;
    private string detailLogin = string.Empty;
    private string detailPassword = string.Empty;
    private string detailCardNumber = string.Empty;
    private string detailCardHolder = string.Empty;
    private string detailExpiryDate = string.Empty;
    private string detailCvv = string.Empty;
    private string detailContent = string.Empty;
    private bool showPassword;
    private bool showCvv;

    private PasswordEntry? selectedPassword;
    private CardEntry? selectedCard;
    private NoteEntry? selectedNote;

    private class SearchResult
    {
        public string Type { get; set; } = string.Empty;
        public string Title { get; set; } = string.Empty;
        public string Subtitle { get; set; } = string.Empty;
        public string SearchText { get; set; } = string.Empty;
        public object Data { get; set; } = default!;
    }

    protected override void OnInitialized()
    {
        VaultSession.StateChanged += OnVaultSessionChanged;

        if (VaultSession.IsAuthenticated)
            LoadData();
    }

    private void OnVaultSessionChanged()
    {
        if (!VaultSession.IsAuthenticated)
            return;

        InvokeAsync(() =>
        {
            LoadData();
            StateHasChanged();
        });
    }

    private void LoadData()
    {
        try
        {
            passwords = PasswordRepository.getAll().OrderBy(item => item.Title).ToList();
            cards = CardRepository.getAll().OrderBy(item => item.Title).ToList();
            notes = NoteRepository.getAll().OrderBy(item => item.Title).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private void ShowPasswordDetail(PasswordEntry item)
    {
        showDetail = true;
        currentDetailType = "password";
        detailTitle = item.Title;
        detailLogin = item.Login;
        detailPassword = item.Password;
        selectedPassword = item;
        selectedCard = null;
        selectedNote = null;
        showPassword = false;
    }

    private void ShowCardDetail(CardEntry item)
    {
        showDetail = true;
        currentDetailType = "card";
        detailTitle = item.Title;
        detailCardNumber = item.CardNumber;
        detailCardHolder = item.CardHolder;
        detailExpiryDate = item.ExpiryDate;
        detailCvv = item.Cvv;
        selectedPassword = null;
        selectedCard = item;
        selectedNote = null;
        showCvv = false;
    }

    private void ShowNoteDetail(NoteEntry item)
    {
        showDetail = true;
        currentDetailType = "note";
        detailTitle = item.Title;
        detailContent = item.Content;
        selectedPassword = null;
        selectedCard = null;
        selectedNote = item;
    }

    private void CloseDetail()
    {
        showDetail = false;
        showPassword = false;
        showCvv = false;
    }

    private void TogglePasswordVisibility() => showPassword = !showPassword;
    private void ToggleCvvVisibility() => showCvv = !showCvv;

    private string GetServiceIconPathForUi(string? currentServiceName, string? fallbackTitle)
    {
        return ServiceImageGenerator.GetServiceIconSource(currentServiceName, fallbackTitle);
    }

    private string GetDetailIcon() => currentDetailType switch
    {
        "password" => "/icons/login.svg",
        "card" => "/icons/card.svg",
        "note" => "/icons/note.svg",
        _ => "/icons/note.svg"
    };

    private void EditItem()
    {
        switch (currentDetailType)
        {
            case "password" when selectedPassword is not null:
                isEditMode = true;
                selectedType = ItemType.Password;
                title = selectedPassword.Title;
                login = selectedPassword.Login;
                password = selectedPassword.Password;
                serviceName = selectedPassword.ServiceName;
                break;

            case "card" when selectedCard is not null:
                isEditMode = true;
                selectedType = ItemType.Card;
                cardTitle = selectedCard.Title;
                cardNumber = FormatCardNumberForInput(selectedCard.CardNumber);
                cardHolder = selectedCard.CardHolder;
                expiryDate = selectedCard.ExpiryDate;
                cvv = selectedCard.Cvv;
                break;

            case "note" when selectedNote is not null:
                isEditMode = true;
                selectedType = ItemType.Note;
                noteTitle = selectedNote.Title;
                noteContent = selectedNote.Content;
                break;

            default:
                return;
        }

        CloseDetail();
        showAddForm = true;
    }

    private async Task DeleteItem()
    {
        try
        {
            if (currentDetailType == "password" && selectedPassword is not null)
            {
                PasswordRepository.Remove(selectedPassword.Id);
                PasswordRepository.Save();
            }
            else if (currentDetailType == "card" && selectedCard is not null)
            {
                CardRepository.Remove(selectedCard.Id);
                CardRepository.Save();
            }
            else if (currentDetailType == "note" && selectedNote is not null)
            {
                NoteRepository.Remove(selectedNote.Id);
                NoteRepository.Save();
            }

            CloseDetail();
            LoadData();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }

        await Task.CompletedTask;
    }

    private void ToggleSearch()
    {
        isSearchExpanded = !isSearchExpanded;
        if (!isSearchExpanded)
        {
            searchQuery = string.Empty;
            activeFilter = "all";
        }
    }

    private void OnSearchBlur()
    {
        if (string.IsNullOrEmpty(searchQuery))
            isSearchExpanded = false;
    }

    private void ClearSearch() => searchQuery = string.Empty;

    private void OnSearchInput(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? string.Empty;
    }

    private void OnSearchKeyPress(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            isSearchExpanded = false;
            searchQuery = string.Empty;
        }
    }

    private void SetFilter(string filter) => activeFilter = filter;

    private List<SearchResult> GetFilteredItems()
    {
        return ApplySearchAndFilter(BuildSearchSource()).ToList();
    }

    private int GetFilteredItemsCount() => GetFilteredItems().Count;

    private string GetItemIcon(SearchResult item) => item.Type switch
    {
        "password" => "/icons/login.svg",
        "card" => "/icons/card.svg",
        "note" => "/icons/note.svg",
        _ => "/icons/note.svg"
    };

    private string GetItemTypeName(string itemType) => itemType switch
    {
        "password" => "Пароль",
        "card" => "Карта",
        "note" => "Заметка",
        _ => itemType
    };

    private void SelectSearchResult(SearchResult item)
    {
        searchQuery = string.Empty;
        isSearchExpanded = false;
        activeFilter = "all";

        switch (item.Type)
        {
            case "password" when item.Data is PasswordEntry passwordItem:
                ShowPasswordDetail(passwordItem);
                break;
            case "card" when item.Data is CardEntry cardItem:
                ShowCardDetail(cardItem);
                break;
            case "note" when item.Data is NoteEntry noteItem:
                ShowNoteDetail(noteItem);
                break;
        }
    }

    private async Task FocusField(CardField field)
    {
        _activeField = field;
        string elementId = field switch
        {
            CardField.Number => "cardNumberInput",
            CardField.Holder => "cardHolderInput",
            CardField.Exp => "expiryInput",
            CardField.Cvv => "cvvInput",
            _ => "cardNumberInput"
        };

        await JS.InvokeVoidAsync("bpFocus", elementId);
    }

    private void OnCardNumberInput(ChangeEventArgs e)
    {
        var digits = new string((e.Value?.ToString() ?? string.Empty).Where(char.IsDigit).ToArray());
        if (digits.Length > 16)
            digits = digits[..16];

        cardNumber = FormatCardNumberForInput(digits);
    }

    private void OnCardHolderInput(ChangeEventArgs e) => cardHolder = (e.Value?.ToString() ?? string.Empty).Trim();

    private void OnCvvInput(ChangeEventArgs e)
    {
        var digits = new string((e.Value?.ToString() ?? string.Empty).Where(char.IsDigit).ToArray());
        if (digits.Length > 3)
            digits = digits[..3];

        cvv = digits;
    }

    private void OnExpiryInput(ChangeEventArgs e)
    {
        var digits = new string((e.Value?.ToString() ?? string.Empty).Where(char.IsDigit).ToArray());
        if (digits.Length > 4)
            digits = digits[..4];

        expiryDate = digits.Length <= 2 ? digits : $"{digits[..2]}/{digits[2..]}";
    }

    private void ToggleCategory(int index)
    {
        expandedIndex = expandedIndex == index ? -1 : index;
    }

    private void OpenAddForm()
    {
        isEditMode = false;
        selectedPassword = null;
        selectedCard = null;
        selectedNote = null;
        SelectType(ItemType.Password);
        ClearForm();
        showAddForm = true;
    }

    private void CloseForm()
    {
        showAddForm = false;
        isEditMode = false;
        ClearForm();
    }

    private void SelectType(ItemType type)
    {
        if (isEditMode)
            return;

        selectedType = type;
    }

    private void ClearForm()
    {
        title = string.Empty;
        login = string.Empty;
        password = string.Empty;
        serviceName = string.Empty;
        cardNumber = string.Empty;
        cardHolder = string.Empty;
        expiryDate = string.Empty;
        cvv = string.Empty;
        cardTitle = string.Empty;
        noteTitle = string.Empty;
        noteContent = string.Empty;
        _activeField = CardField.Number;
    }

    private string MaskCardNumber(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "Номер карты не указан";

        string digits = new(value.Where(char.IsDigit).ToArray());
        if (digits.Length < 4)
            return "••••";

        return $"•••• •••• •••• {digits[^4..]}";
    }

    private string GetNotePreview(string? content)
    {
        if (string.IsNullOrWhiteSpace(content))
            return "Пустая заметка";

        var text = content.Replace("\r", " ").Replace("\n", " ").Trim();
        return text.Length > 50 ? $"{text[..50]}..." : text;
    }

    private int GetNextId<T>(List<T> items) where T : IHasID
    {
        return items.Any() ? items.Max(item => item.Id) + 1 : 1;
    }

    private async Task SaveItem()
    {
        try
        {
            switch (selectedType)
            {
                case ItemType.Password:
                    await SavePasswordAsync();
                    break;
                case ItemType.Card:
                    await SaveCardAsync();
                    break;
                case ItemType.Note:
                    await SaveNoteAsync();
                    break;
            }

            LoadData();
            CloseForm();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private async Task SavePasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(title) || string.IsNullOrWhiteSpace(login))
            return;

        string normalizedServiceName = string.IsNullOrWhiteSpace(serviceName)
            ? title
            : serviceName.Trim();

        if (isEditMode && selectedPassword is not null)
        {
            PasswordRepository.Update(new PasswordEntry
            {
                Id = selectedPassword.Id,
                Title = title.Trim(),
                Login = login.Trim(),
                Password = password,
                ServiceName = normalizedServiceName,
                CreatedAt = selectedPassword.CreatedAt,
                UpdatedAt = DateTime.UtcNow
            });
        }
        else
        {
            PasswordRepository.Add(new PasswordEntry
            {
                Id = GetNextId(passwords),
                Title = title.Trim(),
                Login = login.Trim(),
                Password = password,
                ServiceName = normalizedServiceName,
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            });
        }

        PasswordRepository.Save();
        await Task.CompletedTask;
    }

    private async Task SaveCardAsync()
    {
        if (string.IsNullOrWhiteSpace(cardTitle) || string.IsNullOrWhiteSpace(cardNumber))
            return;

        string normalizedCardNumber = new(cardNumber.Where(char.IsDigit).ToArray());

        if (isEditMode && selectedCard is not null)
        {
            CardRepository.Update(new CardEntry
            {
                Id = selectedCard.Id,
                Title = cardTitle.Trim(),
                CardNumber = normalizedCardNumber,
                CardHolder = cardHolder.Trim(),
                ExpiryDate = expiryDate.Trim(),
                Cvv = cvv.Trim(),
                BankName = selectedCard.BankName,
                CreatedAt = selectedCard.CreatedAt,
                UpdatedAt = DateTime.UtcNow
            });
        }
        else
        {
            CardRepository.Add(new CardEntry
            {
                Id = GetNextId(cards),
                Title = cardTitle.Trim(),
                CardNumber = normalizedCardNumber,
                CardHolder = cardHolder.Trim(),
                ExpiryDate = expiryDate.Trim(),
                Cvv = cvv.Trim(),
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            });
        }

        CardRepository.Save();
        await Task.CompletedTask;
    }

    private async Task SaveNoteAsync()
    {
        if (string.IsNullOrWhiteSpace(noteTitle) && string.IsNullOrWhiteSpace(noteContent))
            return;

        string normalizedTitle = string.IsNullOrWhiteSpace(noteTitle)
            ? "Новая заметка"
            : noteTitle.Trim();

        if (isEditMode && selectedNote is not null)
        {
            NoteRepository.Update(new NoteEntry
            {
                Id = selectedNote.Id,
                Title = normalizedTitle,
                Content = noteContent,
                CreatedAt = selectedNote.CreatedAt,
                UpdatedAt = DateTime.UtcNow
            });
        }
        else
        {
            NoteRepository.Add(new NoteEntry
            {
                Id = GetNextId(notes),
                Title = normalizedTitle,
                Content = noteContent,
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            });
        }

        NoteRepository.Save();
        await Task.CompletedTask;
    }

    private void FilterRecords()
    {
    }

    private IEnumerable<SearchResult> BuildSearchSource()
    {
        foreach (var item in passwords)
        {
            yield return new SearchResult
            {
                Type = "password",
                Title = item.Title,
                Subtitle = string.IsNullOrWhiteSpace(item.Login) ? item.ServiceName : item.Login,
                SearchText = JoinSearchText(item.Title, item.Login, item.ServiceName),
                Data = item
            };
        }

        foreach (var item in cards)
        {
            yield return new SearchResult
            {
                Type = "card",
                Title = item.Title,
                Subtitle = MaskCardNumber(item.CardNumber),
                SearchText = JoinSearchText(item.Title, item.CardHolder, item.BankName, item.CardNumber),
                Data = item
            };
        }

        foreach (var item in notes)
        {
            yield return new SearchResult
            {
                Type = "note",
                Title = item.Title,
                Subtitle = GetNotePreview(item.Content),
                SearchText = JoinSearchText(item.Title, item.Content),
                Data = item
            };
        }
    }

    private IEnumerable<SearchResult> ApplySearchAndFilter(IEnumerable<SearchResult> source)
    {
        IEnumerable<SearchResult> filtered = source;

        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            string query = searchQuery.Trim();
            filtered = filtered.Where(item =>
                ContainsSearchText(item.SearchText, query) ||
                ContainsSearchText(item.Title, query) ||
                ContainsSearchText(item.Subtitle, query));
        }

        if (activeFilter != "all")
            filtered = filtered.Where(item => item.Type == activeFilter);

        return filtered;
    }

    private void ToggleSort()
    {
        if (sortBy == "title")
        {
            sortBy = "type";
        }
        else
        {
            sortBy = "title";
            sortDescending = !sortDescending;
        }

        StateHasChanged();
    }

    private List<SearchResult> GetFilteredItemsSorted()
    {
        var filteredItems = GetFilteredItems();

        return sortBy switch
        {
            "type" => sortDescending
                ? filteredItems.OrderByDescending(item => item.Type).ThenBy(item => item.Title).ToList()
                : filteredItems.OrderBy(item => item.Type).ThenBy(item => item.Title).ToList(),
            _ => sortDescending
                ? filteredItems.OrderByDescending(item => item.Title).ToList()
                : filteredItems.OrderBy(item => item.Title).ToList()
        };
    }

    private static string JoinSearchText(params string?[] values)
    {
        return string.Join(' ', values.Where(value => !string.IsNullOrWhiteSpace(value)));
    }

    private static bool ContainsSearchText(string? value, string query)
    {
        return !string.IsNullOrWhiteSpace(value) &&
            value.Contains(query, StringComparison.OrdinalIgnoreCase);
    }

    private string GetSortIcon()
    {
        return sortBy == "title"
            ? (sortDescending ? "/icons/sort-desc.svg" : "/icons/sort-asc.svg")
            : "/icons/sort-type.svg";
    }

    private static string FormatCardNumberForInput(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return string.Empty;

        var digits = new string(value.Where(char.IsDigit).ToArray());
        return string.Join(" ",
            Enumerable.Range(0, (digits.Length + 3) / 4)
                .Select(index => digits.Skip(index * 4).Take(4))
                .Where(chunk => chunk.Any())
                .Select(chunk => new string(chunk.ToArray())));
    }

    public void Dispose()
    {
        VaultSession.StateChanged -= OnVaultSessionChanged;
    }
