@page "/"

<div class="screen">
    <header class="appbar">
        <div class="appbar-left">
            <button class="icon-button" @onclick="ToggleSort" title="Сортировка">
                <img src="@GetSortIcon()" />
            </button>
        </div>

        <div class="appbar-right">
            <div class="search-wrapper @(isSearchExpanded ? "expanded" : "")">
                <input type="text" 
                       class="search-input" 
                       placeholder="Поиск..." 
                       @bind="searchQuery"
                       @bind:event="oninput"
                       @onkeypress="OnSearchKeyPress"
                       @onblur="OnSearchBlur" />
                @if (!string.IsNullOrEmpty(searchQuery))
                {
                    <button class="search-clear" @onclick="ClearSearch">
                        <img src="icons/close.svg" alt="Очистить" />
                    </button>
                }
            </div>
            <button class="icon-button" @onclick="ToggleSearch">
                <img src="icons/search.svg" alt="Поиск" />
            </button>
        </div>
    </header>

    @if (!string.IsNullOrEmpty(searchQuery))
    {
        <div class="search-results-inline">
            @if (!string.IsNullOrEmpty(searchQuery) && searchResults.Any())
            {
                <div class="sort-indicator">
                    Сортировка: @(sortBy == "title" ? "по названию" : "по типу")
                    @(sortDescending ? "▼" : "▲")
                </div>
            }
            <div class="search-header-inline">
                <span>Найдено: @GetFilteredItemsCount()</span>
            </div>
            
            <div class="search-filters-inline">
                <button class="filter-chip @(activeFilter == "all" ? "active" : "")" @onclick="@(() => SetFilter("all"))">
                    Все
                </button>
                <button class="filter-chip @(activeFilter == "password" ? "active" : "")" @onclick="@(() => SetFilter("password"))">
                    Пароли
                </button>
                <button class="filter-chip @(activeFilter == "card" ? "active" : "")" @onclick="@(() => SetFilter("card"))">
                    Карты
                </button>
                <button class="filter-chip @(activeFilter == "note" ? "active" : "")" @onclick="@(() => SetFilter("note"))">
                    Заметки
                </button>
            </div>

            <div class="search-results-list-inline">
                @foreach (var item in GetFilteredItemsSorted())
                {
                    <div class="search-result-item-inline card" @onclick="@(() => SelectSearchResult(item))">
                        <div class="row-left">
                            <span class="ico">
                                <img src="@GetItemIcon(item)" alt="@item.Type" />
                            </span>
                            <div class="row-text">
                                <div class="row-title">@item.Title</div>
                                <div class="row-sub">@item.Subtitle</div>
                            </div>
                        </div>
                        <div class="result-badge">@GetItemTypeName(item.Type)</div>
                    </div>
                }
    
                @if (!GetFilteredItems().Any())
                {
                    <div class="no-results-inline">
                        <p>Ничего не найдено</p>
                    </div>
                }
            </div>
        </div>
    }
    else
    {
        <main class="content">
            @if (showAddForm)
            {
                <div class="modal-overlay" @onclick="SetFormState">
                    <div class="modal-container" @onclick:stopPropagation="true">
                        <div class="modal-header">
                            <h2>Добавление нового элемента</h2>
                        </div>

                        <div class="modal-body">
                            <div class="form-group">
                                <label>Тип элемента:</label>
                                <div class="type-selector">
                                    <button class="@(selectedType == ItemType.Password ? "active" : "")"
                                            @onclick="@(() => selectedType = ItemType.Password)">
                                        <img src="icons/login.svg" alt="Пароль" />
                                        <span>Пароль</span>
                                    </button>

                                    <button class="@(selectedType == ItemType.Card ? "active" : "")"
                                            @onclick="@(() => selectedType = ItemType.Card)">
                                        <img src="icons/card.svg" alt="Карта" />
                                        <span>Карта</span>
                                    </button>

                                    <button class="@(selectedType == ItemType.Note ? "active" : "")"
                                            @onclick="@(() => selectedType = ItemType.Note)">
                                        <img src="icons/secure_note.svg" alt="Заметка" />
                                        <span>Заметка</span>
                                    </button>
                                </div>
                            </div>

                            @if (selectedType == ItemType.Password)
                            {
                                <div class="password-form">
                                    <div class="form-group">
                                        <label for="passwordTitle">Название</label>
                                        <input type="text" id="passwordTitle" class="form-control" @bind="title" placeholder="Название" />
                                    </div>

                                    <div class="form-group">
                                        <label for="login">Логин</label>
                                        <input type="text" id="login" class="form-control" @bind="login" placeholder="ivan.ivanov@mail.ru" />
                                    </div>

                                    <div class="form-group">
                                        <label for="password">Пароль</label>
                                        <input type="password" id="password" class="form-control" @bind="password" placeholder="········" maxlength="100" />
                                    </div>
                                </div>
                            }

                            @if (selectedType == ItemType.Card)
                            {
                                <div class="card-form">
                                    <div class="card-input"
                                         tabindex="0"
                                         @onclick="@(() => FocusField(CardField.Number))">

                                        <div class="card-chip"></div>

                                        <div class="card-line">
                                            <div class="card-label">Номер</div>
                                            <div class="card-value card-value-mono @(_activeField == CardField.Number ? "is-active" : "")">
                                                @(string.IsNullOrWhiteSpace(cardNumber) ? "1234 5678 9012 3456" : cardNumber)
                                            </div>
                                        </div>

                                        <div class="card-grid">
                                            <div class="card-line" @onclick:stopPropagation="true" @onclick="@(() => FocusField(CardField.Holder))">
                                                <div class="card-label">Владелец</div>
                                                <div class="card-value @(_activeField == CardField.Holder ? "is-active" : "")">
                                                    @(string.IsNullOrWhiteSpace(cardHolder) ? "IVAN IVANOV" : cardHolder.ToUpperInvariant())
                                                </div>
                                            </div>

                                            <div class="card-line" @onclick:stopPropagation="true" @onclick="@(() => FocusField(CardField.Exp))">
                                                <div class="card-label">Срок</div>
                                                <div class="card-value card-value-mono @(_activeField == CardField.Exp ? "is-active" : "")">
                                                    @(string.IsNullOrWhiteSpace(expiryDate) ? "MM/YY" : expiryDate)
                                                </div>
                                            </div>

                                            <div class="card-line" @onclick:stopPropagation="true" @onclick="@(() => FocusField(CardField.Cvv))">
                                                <div class="card-label">CVV</div>
                                                <div class="card-value card-value-mono @(_activeField == CardField.Cvv ? "is-active" : "")">
                                                    @(string.IsNullOrWhiteSpace(cvv) ? "•••" : new string('•', cvv.Length))
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="card-hidden-inputs">
                                        <input id="cardNumberInput" class="form-control" inputmode="numeric" autocomplete="cc-number" maxlength="19" value="@cardNumber" @oninput="OnCardNumberInput" />
                                        <input id="cardHolderInput" class="form-control" autocomplete="cc-name" value="@cardHolder" @oninput="OnCardHolderInput" />
                                        <div class="form-row">
                                            <input id="expiryInput" class="form-control" inputmode="numeric" autocomplete="cc-exp" maxlength="5" value="@expiryDate" @oninput="OnExpiryInput" />
                                            <input id="cvvInput" class="form-control" inputmode="numeric" autocomplete="cc-csc" maxlength="3" value="@cvv" @oninput="OnCvvInput" />
                                        </div>
                                    </div>

                                    <div class="form-group">
                                        <label for="cardTitle">Название карты</label>
                                        <input type="text" id="cardTitle" class="form-control" @bind="cardTitle" placeholder="Например: Зарплатная" />
                                    </div>
                                </div>
                            }

                            @if (selectedType == ItemType.Note)
                            {
                                <div class="note-form">
                                    <div class="form-group">
                                        <label for="noteTitle">Название заметки</label>
                                        <input type="text" id="noteTitle" class="form-control" @bind="noteTitle" placeholder="Важные мысли" />
                                    </div>

                                    <div class="form-group">
                                        <label for="noteContent">Содержание</label>
                                        <textarea id="noteContent" class="form-control note-textarea" @bind="noteContent" rows="8" placeholder="Введите текст заметки..."></textarea>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="modal-footer">
                            <button class="btn btn-primary" @onclick="SaveItem">
                                <img src="icons/plus.svg" alt="Сохранить" />
                                <span>Сохранить</span>
                            </button>
                            <button class="btn btn-secondary" @onclick="SetFormState">Отмена</button>
                        </div>
                    </div>
                </div>
            }

            @if (showDetail)
            {
                <div class="modal-overlay" @onclick="CloseDetail">
                    <div class="detail-container" @onclick:stopPropagation="true">
                        <div class="detail-header">
                            <div class="detail-icon">
                                <img src="@GetDetailIcon()" />
                            </div>
                            <h2>@detailTitle</h2>
                            <button class="close-button" @onclick="CloseDetail">
                                <img src="icons/close.svg" alt="Закрыть" />
                            </button>
                        </div>

                        <div class="detail-body">
                            @if (currentDetailType == "password")
                            {
                                <div class="detail-field">
                                    <label>Название</label>
                                    <div class="field-value">@detailTitle</div>
                                </div>
                                <div class="detail-field">
                                    <label>Логин</label>
                                    <div class="field-value">@detailLogin</div>
                                </div>
                                <div class="detail-field">
                                    <label>Пароль</label>
                                    <div class="field-value password-field">
                                        <span>@(showPassword ? detailPassword : "••••••••")</span>
                                        <button class="icon-button-small" @onclick="TogglePasswordVisibility">
                                            <img src="@(showPassword ? "icons/eye-off.svg" : "icons/eye.svg")" />
                                        </button>
                                    </div>
                                </div>
                            }
                            else if (currentDetailType == "card")
                            {
                                <div class="detail-field">
                                    <label>Название карты</label>
                                    <div class="field-value">@detailTitle</div>
                                </div>
                                <div class="detail-field">
                                    <label>Номер карты</label>
                                    <div class="field-value">@detailCardNumber</div>
                                </div>
                                <div class="detail-field">
                                    <label>Владелец</label>
                                    <div class="field-value">@detailCardHolder</div>
                                </div>
                                <div class="detail-row">
                                    <div class="detail-field">
                                        <label>Срок</label>
                                        <div class="field-value">@detailExpiryDate</div>
                                    </div>
                                    <div class="detail-field">
                                        <label>CVV</label>
                                        <div class="field-value password-field">
                                            <span>@(showCvv ? detailCvv : "•••")</span>
                                            <button class="icon-button-small" @onclick="ToggleCvvVisibility">
                                                <img src="@(showCvv ? "icons/eye-off.svg" : "icons/eye.svg")" />
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            }
                            else if (currentDetailType == "note")
                            {
                                <div class="detail-field">
                                    <label>Название заметки</label>
                                    <div class="field-value">@detailTitle</div>
                                </div>
                                <div class="detail-field">
                                    <label>Содержание</label>
                                    <div class="field-value note-content">@detailContent</div>
                                </div>
                            }
                        </div>

                        <div class="detail-footer">
                            <button class="btn btn-secondary" @onclick="EditItem">
                                <img src="icons/edit.svg" />
                                <span>Редактировать</span>
                            </button>
                            <button class="btn btn-danger" @onclick="DeleteItem">
                                <img src="icons/delete.svg" />
                                <span>Удалить</span>
                            </button>
                        </div>
                    </div>
                </div>
            }

            <section class="card">
                <div class="row" @onclick="@(() => ToggleCategory(0))">
                    <div class="row-left">
                        <span class="ico"><img src="icons/login.svg" alt="Логины" /></span>
                        <span class="row-title">Логины</span>
                    </div>
                    <div>
                        <span class="row-right">@passwords.Count</span>
                        <span>@(expandedIndex == 0 ? "▼" : "▶")</span>
                    </div>
                </div>

                @if (expandedIndex == 0)
                {
                        @if (passwords.Count == 0)
                        {
                            <div class="divider"></div>
                            <div class="row"><span style="margin: 0 auto; color: #999;">Нет данных</span></div>
                        }
                        else
                        {
                            @foreach (var i in passwords)
                            {
                                <div class="divider"></div>
                                <div class="row">
                                    <div class="row-left" @onclick="@(() => ShowPasswordDetail(i))">
                                        <span class="brand">
                                            <img src="@GetServiceIconPathForUi(i.ServiceName)" alt="@i.Title" width="40" height="40" />
                                        </span>
                                        <div class="row-text">
                                            <div class="row-title">@i.Title</div>
                                            <div class="row-sub">@i.Login</div>
                                        </div>
                                    </div>
                                    <button class="kebab" aria-label="Действия" @onclick="(() => ShowPasswordDetail(i))" @onclick:stopPropagation="true">
                                        <span></span><span></span><span></span>
                                    </button>
                                </div>
                            }
                        }
                }
            </section>

            <section class="card">
                <div class="row" @onclick="@(() => ToggleCategory(1))">
                    <div class="row-left">
                        <span class="ico"><img src="icons/card.svg" alt="Карты" /></span>
                        <span class="row-title">Карты</span>
                    </div>
                    <div>
                        <span class="row-right">@cards.Count</span>
                        <span>@(expandedIndex == 1 ? "▼" : "▶")</span>
                    </div>
                </div>

                @if (expandedIndex == 1)
                {
                    <div>
                        @if (cards.Count == 0)
                        {
                            <div class="divider"></div>
                            <div class="row"><span style="margin: 0 auto; color: #999;">Нет данных</span></div>
                        }
                        else
                        {
                            @foreach (var i in cards)
                            {
                               <div class="divider"></div>
                                <div class="row">
                                    <div class="row-left" @onclick="@(() => ShowCardDetail(i))">
                                        <span class="brand">
                                            <img src="icons/card.svg" alt="@i.Title" width="40" height="40" />
                                        </span>
                                        <div class="row-text">
                                            <div class="row-title">@i.Title</div>
                                            <div class="row-sub">@MaskCardNumber(i.CardNumber)</div>
                                        </div>
                                    </div>
                                    <button class="kebab" aria-label="Действия" @onclick="(() => ShowCardDetail(i))" @onclick:stopPropagation="true">
                                        <span></span><span></span><span></span>
                                    </button>
                                </div>
                            }
                        }
                    </div>
                }
            </section>

            <section class="card">
                <div class="row" @onclick="@(() => ToggleCategory(2))">
                    <div class="row-left">
                        <span class="ico"><img src="icons/note.svg" alt="Защищённые заметки" /></span>
                        <span class="row-title">Защищённые заметки</span>
                    </div>
                    <div>
                        <span class="row-right">@notes.Count</span>
                        <span>@(expandedIndex == 2 ? "▼" : "▶")</span>
                    </div>
                </div>

                @if (expandedIndex == 2)
                {
                    <div>
                        @if (notes.Count == 0)
                        {
                            <div class="divider"></div>
                            <div class="row"><span style="margin: 0 auto; color: #999;">Нет данных</span></div>
                        }
                        else
                        {
                            @foreach (var i in notes)
                            {
                               <div class="divider"></div>
<div class="row">
    <div class="row-left" @onclick="@(() => ShowNoteDetail(i))">
        <span class="brand">
            <img src="icons/note.svg" alt="@i.Title" width="40" height="40" />
        </span>
        <div class="row-text">
            <div class="row-title">@i.Title</div>
            <div class="row-sub">@GetNotePreview(i.Content)</div>
        </div>
    </div>
    <button class="kebab" aria-label="Действия" @onclick="(() => ShowNoteDetail(i))" @onclick:stopPropagation="true">
        <span></span><span></span><span></span>
    </button>
</div>
                            }
                        }
                    </div>
                }
            </section>

            <button class="fab" @onclick="SetFormState">
                <img src="icons/plus.svg" alt="Добавить" />
            </button>
        </main>
    }
</div>


@code {
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private SecureRepository<PasswordEntry> PasswordRepository { get; set; } = default!;
    [Inject] private SecureRepository<CardEntry> CardRepository { get; set; } = default!;
    [Inject] private SecureRepository<NoteEntry> NoteRepository { get; set; } = default!;

    private List<SearchResult> searchResults = new();
    private List<PasswordEntry> passwords = new();
    private List<CardEntry> cards = new();
    private List<NoteEntry> notes = new();

    private enum CardField { Number, Holder, Exp, Cvv }
    private CardField _activeField = CardField.Number;
    private enum ItemType { Password, Card, Note }
    private ItemType selectedType = ItemType.Password;

    private string title = "", login = "", password = "";
    private string cardNumber = "", cardHolder = "", expiryDate = "", cvv = "", cardTitle = "";
    private string noteTitle = "", noteContent = "";
    private int expandedIndex = 0;
    private bool showAddForm = false;
    
    private string searchQuery = "";
    private bool isSearchExpanded = false;
    private string activeFilter = "all";

    // Детальный просмотр
    private bool showDetail = false;
    private string currentDetailType = "";
    private string detailTitle = "", detailLogin = "", detailPassword = "";
    private string detailCardNumber = "", detailCardHolder = "", detailExpiryDate = "", detailCvv = "", detailContent = "";
    private bool showPassword = false, showCvv = false;
    private PasswordEntry? selectedPassword = null;
    private CardEntry? selectedCard = null;
    private NoteEntry? selectedNote = null;

    private class SearchResult { 
        public string Type { get; set; } = "";
        public string Title { get; set; } = "";
        public string Subtitle { get; set; } = ""; 
        public object Data { get; set; } = null!; 
    }

    protected override void OnInitialized() => LoadData();

    private void LoadData()
    {
        try { 
            passwords = PasswordRepository.getAll().ToList(); 
            cards = CardRepository.getAll().ToList();
            notes = NoteRepository.getAll().ToList();
        }
        catch (Exception ex) { Console.WriteLine($"Error: {ex.Message}"); }
    }

    private void ShowPasswordDetail(PasswordEntry p)
    {
        showDetail = true; 
        currentDetailType = "password";
        detailTitle = p.Title;
        detailLogin = p.Login; 
        detailPassword = p.Password;
        selectedPassword = p; 
        showPassword = false;
    }

    private void ShowCardDetail(CardEntry c)
    {
        showDetail = true; 
        currentDetailType = "card";
        detailTitle = c.Title; 
        detailCardNumber = c.CardNumber;
        detailCardHolder = c.CardHolder;
        detailExpiryDate = c.ExpiryDate; 
        detailCvv = c.Cvv;
        selectedCard = c;
        showCvv = false;
    }

    private void ShowNoteDetail(NoteEntry n)
    {
        showDetail = true;
        currentDetailType = "note";
        detailTitle = n.Title; 
        detailContent = n.Content;
        selectedNote = n;
    }

    private void CloseDetail() { 
        showDetail = false;
        showPassword = showCvv = false;
    }
    private void TogglePasswordVisibility() => showPassword = !showPassword;
    private void ToggleCvvVisibility() => showCvv = !showCvv;

    private string GetServiceIconPathForUi(string? serviceName)
    {
        var path = ServiceImageGenerator.GetServiceIconPath(serviceName ?? string.Empty);
        return path.Replace('\\', '/');
    }
    private string GetDetailIcon() => currentDetailType switch { "password" => "icons/login.svg", "card" => "icons/card.svg", "note" => "icons/note.svg", _ => "icons/file.png" };

    private void EditItem() {
        Console.WriteLine($"Edit: {currentDetailType}"); 
        CloseDetail(); 
    }
    
    private async Task DeleteItem()
    {
        if (currentDetailType == "password" && selectedPassword != null) { passwords.Remove(selectedPassword); PasswordRepository.Save(); }
        else if (currentDetailType == "card" && selectedCard != null) { cards.Remove(selectedCard); CardRepository.Save(); }
        else if (currentDetailType == "note" && selectedNote != null) { notes.Remove(selectedNote); NoteRepository.Save(); }
        CloseDetail(); 
        LoadData();
        await Task.CompletedTask;
    }

    private void ToggleSearch() { 
        isSearchExpanded = !isSearchExpanded;
        if (!isSearchExpanded) { 
            searchQuery = "";
            activeFilter = "all"; 
        } 
    }
    private void OnSearchBlur() { 
        if (string.IsNullOrEmpty(searchQuery)) isSearchExpanded = false;
    }
    private void ClearSearch() => searchQuery = "";
    private void OnSearchKeyPress(KeyboardEventArgs e) { if (e.Key == "Escape") { isSearchExpanded = false; searchQuery = ""; } }
    private void SetFilter(string f) => activeFilter = f;
    private List<SearchResult> GetFilteredItems()
    {
        filterRecord();
        return searchResults;
    }
    private int GetFilteredItemsCount()
    {
        return GetFilteredItems().Count;
    }
    private string GetItemIcon(SearchResult i) => i.Type switch { "password" => "icons/login.svg", "card" => "icons/card.svg", "note" => "icons/note.svg", _ => "icons/file.png" };
    private string GetItemTypeName(string t) => t switch { "password" => "Пароль", "card" => "Карта", "note" => "Заметка", _ => t };
    private void SelectSearchResult(SearchResult item)
    {
        searchQuery = "";
        isSearchExpanded = false;
        activeFilter = "all";
    
        switch (item.Type)
        {
            case "password":
                if (item.Data is PasswordEntry p)
                    ShowPasswordDetail(p);
                break;
            case "card":
                if (item.Data is CardEntry c)
                    ShowCardDetail(c);
                break;
            case "note":
                if (item.Data is NoteEntry n)
                    ShowNoteDetail(n);
                break;
        }
    }

    private async Task FocusField(CardField f) { 
        _activeField = f;
        var id = f switch { CardField.Number => "cardNumberInput", CardField.Holder => "cardHolderInput", CardField.Exp => "expiryInput", CardField.Cvv => "cvvInput", _ => "cardNumberInput" };
        await JS.InvokeVoidAsync("bpFocus", id); 
    }
    private void OnCardNumberInput(ChangeEventArgs e) { 
        var r = e.Value?.ToString() ?? "";
        var d = new string(r.Where(char.IsDigit).ToArray());
        if (d.Length > 16) d = d[..16]; 
        cardNumber = string.Join(" ", Enumerable.Range(0, (d.Length + 3) / 4).Select(i => d.Skip(i * 4).Take(4)).Where(g => g.Any()).Select(g => new string(g.ToArray())));
    }
    private void OnCardHolderInput(ChangeEventArgs e) => cardHolder = (e.Value?.ToString() ?? "").Trim();
    private void OnCvvInput(ChangeEventArgs e) { 
        var r = e.Value?.ToString() ?? ""; 
        var d = new string(r.Where(char.IsDigit).ToArray()); 
        if (d.Length > 3) d = d[..3]; cvv = d; 
    }
    private void OnExpiryInput(ChangeEventArgs e) {
        var r = e.Value?.ToString() ?? "";
        var d = new string(r.Where(char.IsDigit).ToArray());
        if (d.Length > 4) d = d[..4]; 
        expiryDate = d.Length switch { <= 2 => d, _ => d[..2] + "/" + d[2..] }; 
    }
    private void ToggleCategory(int i) => expandedIndex = expandedIndex == i ? -1 : i;
    private void SetFormState() { 
        showAddForm = !showAddForm;
        if (!showAddForm) ClearForm(); 
        else selectedType = ItemType.Password; 
    }
    private void ClearForm() { title = login = password = cardNumber = cardHolder = expiryDate = cvv = cardTitle = noteTitle = noteContent = ""; }
    private string MaskCardNumber(string? v) { 
        if (string.IsNullOrWhiteSpace(v)) 
        return "Номер карты не указан"; 
        var d = new string(v.Where(char.IsDigit).ToArray()); 
        if (d.Length < 4) return "••••"; 
        return $"•••• •••• •••• {d[^4..]}"; 
    }
    private string GetNotePreview(string? c) {
        if (string.IsNullOrWhiteSpace(c)) return "Пустая заметка";
        var t = c.Replace("\r", " ").Replace("\n", " ").Trim(); 
        return t.Length > 50 ? t[..50] + "..." : t; 
    }
    private int GetNextId<T>(List<T> items) where T : IHasID => items.Any() ? items.Max(x => x.Id) + 1 : 1;

    private async Task SaveItem()
    {
        try
        {
            switch (selectedType)
            {
                case ItemType.Password: PasswordRepository.Add(new PasswordEntry {  Id = GetNextId(passwords), Title = title, Login = login, Password = password });
                    PasswordRepository.Save(); 
                    break;
                case ItemType.Card: CardRepository.Add(new CardEntry { Id = GetNextId(cards), Title = cardTitle, CardNumber = cardNumber.Replace(" ", ""), CardHolder = cardHolder, ExpiryDate = expiryDate, Cvv = cvv });
                    CardRepository.Save(); 
                    break;
                case ItemType.Note: NoteRepository.Add(new NoteEntry { Id = GetNextId(notes), Title = noteTitle, Content = noteContent }); 
                    NoteRepository.Save(); 
                    break;
            }
            LoadData(); ClearForm(); showAddForm = false;
        }
        catch (Exception ex) { Console.WriteLine($"Error: {ex.Message}"); }
        await Task.CompletedTask;
    }

    private void filterRecord()
    {
        var allItems = new List<SearchResult>();
    
        foreach (var p in passwords)
        {
            allItems.Add(new SearchResult
            {
                Type = "password",
                Title = p.Title,
                Subtitle = p.Login,
                Data = p
            });
        }
    
        foreach (var c in cards)
        {
            allItems.Add(new SearchResult
            {
                Type = "card",
                Title = c.Title,
                Subtitle = MaskCardNumber(c.CardNumber),
                Data = c
            });
        }
    
        foreach (var n in notes)
        {
            allItems.Add(new SearchResult
            {
                Type = "note",
                Title = n.Title,
                Subtitle = GetNotePreview(n.Content),
                Data = n
            });
        }
    
        if (!string.IsNullOrWhiteSpace(searchQuery))
        {
            string query = searchQuery.ToLowerInvariant();
            allItems = allItems.Where(item => 
                item.Title.ToLowerInvariant().Contains(query) || 
                item.Subtitle.ToLowerInvariant().Contains(query)
            ).ToList();
        }
    
        if (activeFilter != "all")
        {
            allItems = allItems.Where(item => item.Type == activeFilter).ToList();
        }
    
        allItems = allItems.OrderBy(item => item.Title).ToList();
    
        searchResults = allItems;
    }
    private string sortBy = "title"; // title, type, date
private bool sortDescending = false;

    private void ToggleSort()
    {
        if (sortBy == "title")
        {
            sortBy = "type";
        }
        else if (sortBy == "type")
        {
            sortBy = "title";
            sortDescending = !sortDescending;
        }
    
        filterRecord();
        StateHasChanged();
    }
    private List<SearchResult> GetFilteredItemsSorted()
    {
        filterRecord();
    
        var results = searchResults.ToList();
    
        
        switch (sortBy)
        {
            case "title":
                results = sortDescending 
                    ? results.OrderByDescending(x => x.Title).ToList()
                    : results.OrderBy(x => x.Title).ToList();
                break;
            case "type":
                results = sortDescending
                    ? results.OrderByDescending(x => x.Type).ThenBy(x => x.Title).ToList()
                    : results.OrderBy(x => x.Type).ThenBy(x => x.Title).ToList();
                break;
        }
    
        return results;
    }

    private string GetSortIcon()
    {
        if (sortBy == "title")
            return sortDescending ? "icons/sort-desc.svg" : "icons/sort-asc.svg";
        else
            return "icons/sort-type.svg";
    }
