@page "/"


@*
@code {
    private enum ItemType { Password, Card, Note }
    private ItemType selectedType = ItemType.Password;

    // Общие поля
    private string title = "";
    
    // Поля для пароля
    private string login = "";
    private string password = "";
    
    // Поля для карточки
    private string cardNumber = "";
    private string cardHolder = "";
    private string expiryDate = "";
    private string cvv = "";
    
    // Поля для заметки
    private string noteTitle = "";
    private string noteContent = "";

    private bool showAddForm = false;

    private void SaveItem()
    {
        Console.WriteLine($"Сохранение {selectedType}:");
        
        switch (selectedType)
        {
            case ItemType.Password:
                Console.WriteLine($"  Название: {title}");
                Console.WriteLine($"  Логин: {login}");
                Console.WriteLine($"  Пароль: {password}");
                break;
            case ItemType.Card:
                Console.WriteLine($"  Название: {title}");
                Console.WriteLine($"  Номер: {cardNumber}");
                Console.WriteLine($"  Владелец: {cardHolder}");
                Console.WriteLine($"  Срок: {expiryDate}");
                Console.WriteLine($"  CVV: {cvv}");
                break;
            case ItemType.Note:
                Console.WriteLine($"  Название заметки: {noteTitle}");
                Console.WriteLine($"  Содержание: {noteContent}");
                break;
        }
        
        // Очистка формы
        title = "";
        login = "";
        password = "";
        cardNumber = "";
        cardHolder = "";
        expiryDate = "";
        cvv = "";
        noteTitle = "";
        noteContent = "";
        
        showAddForm = false;
    }

    private void ToggleForm()
    {
        showAddForm = !showAddForm;
        if (showAddForm)
        {
            selectedType = ItemType.Password;
        }
    }

    private void CloseForm()
    {
        showAddForm = false;
    }
}
*@

<!doctype html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Мой сейф</title>
    <link rel="stylesheet" href="styles.css" />
</head>
<body>
    <div class="screen">
        <!-- Top app bar -->
        <header class="appbar">
            <button class="icon-btn" aria-label="Меню">
                <img src="icons/menu.png" alt="Меню" />
            </button>

            <h1 class="appbar-title">Мой сейф</h1>

            <button class="icon-btn" aria-label="Профиль">
                <img src="icons/profile.png" alt="Профили" />
            </button>
        </header>

        <!-- Content -->
        <main class="content">

            <!-- Форма добавления -->
            @*
            @if (showAddForm)
            {
                <div class="modal-overlay" @onclick="CloseForm">
                    <div class="modal-container" @onclick:stopPropagation="true">
                        <div class="modal-header">
                            <h2>Добавление нового элемента</h2>
                        </div>

                        <div class="modal-body">
                            <div class="form-group">
                                <label>Тип элемента:</label>
                                <div class="type-selector">
                                    <button class="@(selectedType == ItemType.Password ? "active" : "")" @onclick="() => selectedType = ItemType.Password">
                                        <img src="icons/login.png" alt="Пароль" />
                                        <span>Пароль</span>
                                    </button>
                                    <button class="@(selectedType == ItemType.Card ? "active" : "")" @onclick="() => selectedType = ItemType.Card">
                                        <img src="icons/card.png" alt="Карта" />
                                        <span>Карта</span>
                                    </button>
                                    <button class="@(selectedType == ItemType.Note ? "active" : "")" @onclick="() => selectedType = ItemType.Note">
                                        <img src="icons/secure_note.png" alt="Заметка" />
                                        <span>Заметка</span>
                                    </button>
                                </div>
                            </div>

                            @if (selectedType == ItemType.Password)
                            {
                                <div class="password-form">
                                    <div class="form-group">
                                        <label for="title">Название</label>
                                        <input type="text" id="title" class="form-control" @bind="title" placeholder="Название" />
                                    </div>
                                    <div class="form-group">
                                        <label for="login">Логин</label>
                                        <input type="text" id="login" class="form-control" @bind="login" placeholder="ivan.ivanov@mail.ru" />
                                    </div>
                                    <div class="form-group">
                                        <label for="password">Пароль</label>
                                        <input type="password" id="password" class="form-control" @bind="password" placeholder="········" />
                                    </div>
                                </div>
                            }

                            @if (selectedType == ItemType.Card)
                            {
                                <div class="card-form">
                                    <div class="form-group">
                                        <label for="title">Название карты</label>
                                        <input type="text" id="title" class="form-control" @bind="title" placeholder="Карта" />
                                    </div>
                                    <div class="form-group">
                                        <label for="cardNumber">Номер карты</label>
                                        <input type="text" id="cardNumber" class="form-control" @bind="cardNumber" placeholder="1234 5678 9012 3456" />
                                    </div>
                                    <div class="form-group">
                                        <label for="cardHolder">Владелец</label>
                                        <input type="text" id="cardHolder" class="form-control" @bind="cardHolder" placeholder="IVAN IVANOV" />
                                    </div>
                                    <div class="form-row">
                                        <div class="form-group half">
                                            <label for="expiryDate">Срок действия</label>
                                            <input type="text" id="expiryDate" class="form-control" @bind="expiryDate" placeholder="12/25" />
                                        </div>
                                        <div class="form-group half">
                                            <label for="cvv">CVV</label>
                                            <input type="password" id="cvv" class="form-control" @bind="cvv" placeholder="123" maxlength="3" />
                                        </div>
                                    </div>
                                </div>
                            }

                            @if (selectedType == ItemType.Note)
                            {
                                <div class="note-form">
                                    <div class="form-group">
                                        <label for="noteTitle">Название заметки</label>
                                        <input type="text" id="noteTitle" class="form-control" @bind="noteTitle" placeholder="Важные мысли" />
                                    </div>
                                    <div class="form-group">
                                        <label for="noteContent">Содержание</label>
                                        <textarea id="noteContent" class="form-control note-textarea" @bind="noteContent" rows="8" placeholder="Введите текст заметки..."></textarea>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="modal-footer">
                            <button class="btn btn-primary" @onclick="SaveItem">
                                <img src="icons/plus.png" alt="Сохранить" />
                                <span>Сохранить</span>
                            </button>
                            <button class="btn btn-secondary" @onclick="CloseForm">
                                Отмена
                            </button>
                        </div>
                    </div>
                </div>
            }
            *@

            <!-- TYPES -->
            <div class="section-label">ТИПЫ (4)</div>

            <section class="card">
                <div class="row">
                    <div class="row-left">
                        <span class="ico">
                            <img src="icons/login.png" alt="Логины" />
                        </span>
                        <span class="row-title">Логины</span>
                    </div>
                    <span class="row-right">5</span>
                </div>
                <div class="divider"></div>

                <div class="row">
                    <div class="row-left">
                        <span class="ico">
                            <img src="icons/card.png" alt="Карты" />
                        </span>
                        <span class="row-title">Карты</span>
                    </div>
                    <span class="row-right">2</span>
                </div>
                <div class="divider"></div>

                <div class="row">
                    <div class="row-left">
                        <span class="ico">
                            <img src="icons/person.png" alt="Личность" />
                        </span>
                        <span class="row-title">Личность</span>
                    </div>
                    <span class="row-right">0</span>
                </div>
                <div class="divider"></div>

                <div class="row">
                    <div class="row-left">
                        <span class="ico">
                            <img src="icons/secure_note.png" alt="Защищённая заметка" />
                        </span>
                        <span class="row-title">Защищённая заметка</span>
                    </div>
                    <span class="row-right">0</span>
                </div>
            </section>

            <!-- WITHOUT FOLDERS -->
            <div class="section-label">БЕЗ ПАПОК (5)</div>

            <section class="card">
                <!-- Яндекс -->
                <div class="row">
                    <div class="row-left">
                        <span class="brand">
                            <img src="passwords/yandex.png" alt="Яндекс" width="40" height="40" />
                        </span>
                        <div class="row-text">
                            <div class="row-title">Яндекс</div>
                            <div class="row-sub">ivan.ivanov@mail.ru</div>
                        </div>
                    </div>
                    <button class="kebab" aria-label="Действия">
                        <span></span><span></span><span></span>
                    </button>
                </div>
                <div class="divider"></div>

                <!-- ВКонтакте -->
                <div class="row">
                    <div class="row-left">
                        <span class="brand">
                            <img src="passwords/vk.jpg" alt="ВКонтакте" width="40" height="40" />
                        </span>
                        <div class="row-text">
                            <div class="row-title">ВКонтакте</div>
                            <div class="row-sub">ivan.ivanov@mail.ru</div>
                        </div>
                    </div>
                    <button class="kebab" aria-label="Действия">
                        <span></span><span></span><span></span>
                    </button>
                </div>
                <div class="divider"></div>

                <!-- СберБанк -->
                <div class="row">
                    <div class="row-left">
                        <span class="brand">
                            <img src="passwords/sber.jpg" alt="СберБанк" width="40" height="40" />
                        </span>
                        <div class="row-text">
                            <div class="row-title">СберБанк</div>
                            <div class="row-sub">i.ivanov@mail.ru</div>
                        </div>
                    </div>
                    <button class="kebab" aria-label="Действия">
                        <span></span><span></span><span></span>
                    </button>
                </div>
                <div class="divider"></div>

                <!-- Google -->
                <div class="row">
                    <div class="row-left">
                        <span class="brand">
                            <img src="passwords/google.webp" alt="Google" width="40" height="40" />
                        </span>
                        <div class="row-text">
                            <div class="row-title">Google</div>
                            <div class="row-sub">i.ivanov@mail.ru</div>
                        </div>
                    </div>
                    <button class="kebab" aria-label="Действия">
                        <span></span><span></span><span></span>
                    </button>
                </div>
                <div class="divider"></div>

                <!-- GitHub -->
                <div class="row">
                    <div class="row-left">
                        <span class="brand">
                            <img src="passwords/github.jpg" alt="GitHub" width="40" height="40" />
                        </span>
                        <div class="row-text">
                            <div class="row-title">GitHub</div>
                            <div class="row-sub">i.ivanov@mail.ru</div>
                        </div>
                    </div>
                    <button class="kebab" aria-label="Действия">
                        <span></span><span></span><span></span>
                    </button>
                </div>
            </section>

            <!-- Floating action button (просто иконка, без функционала) -->
            <button class="fab" aria-label="Добавить">
                <img src="icons/plus.png" alt="Добавить" />
            </button>
        </main>

        <!-- Bottom nav -->
        <nav class="bottom-nav" aria-label="Навигация">
            <a class="nav-item active" href="#" aria-current="page">
                <span class="nav-ico">
                    <img src="icons/mech.png" alt="Сейф" />
                </span>
                <span class="nav-text">Мой сейф</span>
            </a>

            <a class="nav-item" href="#">
                <span class="nav-ico">
                    <img src="icons/send.png" alt="Отправка" />
                </span>
                <span class="nav-text">Отправка</span>
            </a>

            <a class="nav-item" href="#">
                <span class="nav-ico">
                    <img src="icons/generator.png" alt="Генератор" />
                </span>
                <span class="nav-text">Генератор</span>
            </a>

            <a class="nav-item" href="#">
                <span class="nav-ico">
                    <img src="icons/settings.png" alt="Настройки" />
                </span>
                <span class="nav-text">Настройки</span>
            </a>
        </nav>
    </div>
</body>
</html>