@page "/generator"

<!-- Страница генратора паролей -->
<div class="screen">
    <!-- Top app bar -->
    <header class="appbar">
        <button class="icon-btn" aria-label="Меню">
            <img src="icons/menu.png" alt="Меню" />
        </button>

        <h1 class="appbar-title">Генератор паролей</h1>

        <button class="icon-btn" aria-label="Профиль">
            <img src="icons/profile.png" alt="Профили" />
        </button>
    </header>

    <!-- Content -->
    <main class="content">
        <div class="generator-container">
            <!-- Текстовый блок с паролем -->
            <div class="password-display-area">
                <div class="password-display" id="generatedPassword">@generatedPassword</div>
                
                <!-- Кнопка генерации -->
                <button class="btn-generate" @onclick="GeneratePassword">
                    <img src="icons/generator.png" alt="Сгенерировать" />
                    <span>Сгенерировать</span>
                </button>
            </div>

            <!-- Набор галочек -->
            <div class="options-section">
                <h3>Настройки пароля</h3>
                
                <!-- Длина пароля -->
                <div class="form-group">
                    <label for="passwordLength">Длина пароля:</label>
                    <input type="number" id="passwordLength" class="form-control" @bind="passwordLength" min="4" max="32" />
                </div>

                <!-- Цифры -->
                <div class="checkbox-item">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="includeDigits" />
                        <span class="checkbox-text">Цифры (0-9)</span>
                    </label>
                </div>

                <!-- Буквы латинского алфавита (2 галочки) -->
                <div class="checkbox-item">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="includeLowercase" />
                        <span class="checkbox-text">Строчные буквы (a-z)</span>
                    </label>
                </div>

                <div class="checkbox-item">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="includeUppercase" />
                        <span class="checkbox-text">Прописные буквы (A-Z)</span>
                    </label>
                </div>

                <!-- Специальные символы -->
                <div class="checkbox-item">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="includeSpecial" />
                        <span class="checkbox-text">Специальные символы (!&#64;#$%^&*)</span>
                    </label>
                </div>
            </div>

            <!-- Информация о силе пароля -->
            <div class="password-strength">
                <h3>Сила пароля</h3>
                <div class="strength-meter">
                    <div class="strength-bar" style="width: @GetStrengthPercentage()%;"></div>
                </div>
                <div class="strength-text">@GetStrengthText()</div>
                <div class="strength-details">
                    <small>Активных опций: @GetActiveOptionsCount() из 4</small>
                </div>
            </div>
        </div>
    </main>

    <!-- Кнопка навигации с ссылкой на генератор -->
    <nav class="bottom-nav" aria-label="Навигация">
        <a class="nav-item" href="/">
            <span class="nav-ico">
                <img src="icons/mech.png" alt="Сейф" />
            </span>
            <span class="nav-text">Мой сейф</span>
        </a>

        <a class="nav-item" href="/">
            <span class="nav-ico">
                <img src="icons/send.png" alt="Отправка" />
            </span>
            <span class="nav-text">Отправка</span>
        </a>

        <a class="nav-item active" href="/generator" aria-current="page">
            <span class="nav-ico">
                <img src="icons/generator.png" alt="Генератор" />
            </span>
            <span class="nav-text">Генератор</span>
        </a>

        <a class="nav-item" href="/">
            <span class="nav-ico">
                <img src="icons/settings.png" alt="Настройки" />
            </span>
            <span class="nav-text">Настройки</span>
        </a>
    </nav>
</div>

