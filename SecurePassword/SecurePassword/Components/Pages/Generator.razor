@page "/generator"

<div class="screen">
    <header class="appbar">
        <h1 class="appbar-title">Генератор паролей</h1>
    </header>

    <main class="content">
        <div class="generator-container">
            <div class="password-display-area">
                <div class="password-display" @onclick="CopyPassword" id="generatedPassword">@generatedPassword</div>

                <button class="btn-generate" @onclick="GeneratePasswordValue">
                    <img src="/icons/generator.svg" alt="Сгенерировать" />
                    <span>Сгенерировать</span>
                </button>
            </div>

            <div class="options-section">
                <h3>Настройки пароля</h3>

                <div class="form-group">
                    <label for="passwordLength">Длина пароля</label>
                    <input type="number" id="passwordLength" class="form-control" @bind="PasswordLength" @bind:event="oninput" min="4" max="255" />
                </div>

                <div class="checkbox-item">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="includeDigits" @onclick="ResetPasswordPreview" />
                        <span class="checkbox-text">Цифры (0-9)</span>
                    </label>
                </div>

                <div class="checkbox-item">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="includeLowercase" @onclick="ResetPasswordPreview" />
                        <span class="checkbox-text">Строчные буквы (a-z)</span>
                    </label>
                </div>

                <div class="checkbox-item">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="includeUppercase" @onclick="ResetPasswordPreview" />
                        <span class="checkbox-text">Прописные буквы (A-Z)</span>
                    </label>
                </div>

                <div class="checkbox-item">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="includeSpecial" @onclick="ResetPasswordPreview" />
                        <span class="checkbox-text">Специальные символы (!&#64;#$%^&*)</span>
                    </label>
                </div>
            </div>

            @if (HasEvaluatedPassword)
            {
                <div class="password-strength">
                    <h3>Сила пароля</h3>
                    <div class="strength-meter">
                        <div class="strength-bar @GetStrengthClass()" style="width: @GetStrengthPercentage()%;"></div>
                    </div>
                    <div class="strength-text">@GetStrengthText()</div>
                    <div class="strength-details">
                        <small>Энтропия: @GetEntropyBits() бит • Активных опций: @GetActiveOptionsCount() из 4</small>
                    </div>
                </div>
            }

            @if (copied)
            {
                <div class="copy-toast">
                    <span class="copy-toast-icon">✓</span>
                    <span class="copy-toast-text">Пароль скопирован</span>
                </div>
            }
        </div>
    </main>
</div>

@code {
    private const string InitialMessage = "Нажмите кнопку для генерации";
    private const string ValidationMessage = "Должен быть выбран хотя бы один тип символов";

    private string generatedPassword = InitialMessage;
    private byte passwordLength = 12;
    private bool includeDigits = true;
    private bool includeLowercase = true;
    private bool includeUppercase = true;
    private bool includeSpecial;
    private bool copied;

    public int PasswordLength
    {
        get => passwordLength;
        set => passwordLength = (byte)Math.Clamp(value, 4, 255);
    }

    private bool HasEvaluatedPassword =>
        !string.IsNullOrWhiteSpace(generatedPassword) &&
        generatedPassword != InitialMessage &&
        generatedPassword != ValidationMessage;

    private void GeneratePasswordValue()
    {
        try
        {
            generatedPassword = PasswordGenerator.GeneratePassword(
                includeLowercase,
                includeUppercase,
                includeDigits,
                includeSpecial,
                passwordLength);
        }
        catch (ArgumentException exception)
        {
            generatedPassword = exception.Message.Replace("\n", " ");
        }
    }

    private async Task CopyPassword()
    {
        if (!HasEvaluatedPassword)
            return;

        await Clipboard.SetTextAsync(generatedPassword);
        copied = true;
        StateHasChanged();

        await Task.Delay(1500);

        copied = false;
        StateHasChanged();
    }

    private int GetActiveOptionsCount()
    {
        return Convert.ToInt32(includeDigits) +
            Convert.ToInt32(includeLowercase) +
            Convert.ToInt32(includeUppercase) +
            Convert.ToInt32(includeSpecial);
    }

    private string GetStrengthClass()
    {
        return PasswordValidator.CalculateCryptographicStrength(generatedPassword) switch
        {
            1 => "strength-weak",
            2 => "strength-medium",
            3 => "strength-strong",
            _ => "strength-strong"
        };
    }

    private int GetStrengthPercentage()
    {
        return PasswordValidator.CalculateStrengthPercentage(generatedPassword);
    }

    private void ResetPasswordPreview()
    {
        generatedPassword = InitialMessage;
    }

    private string GetStrengthText()
    {
        return PasswordValidator.CalculateCryptographicStrength(generatedPassword) switch
        {
            1 => "Слабый",
            2 => "Нормальный",
            3 => "Хороший",
            4 => "Отличный",
            _ => "Недостаточно данных"
        };
    }

    private string GetEntropyBits()
    {
        return PasswordValidator.CalculateEntropyBits(generatedPassword).ToString("0.#");
    }
}
