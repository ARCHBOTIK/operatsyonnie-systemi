@page "/generator"
@using SecurePassword;

<!-- Страница генератора паролей -->
<div class="screen">
    <!-- Top app bar -->
    <header class="appbar">
        <h1 class="appbar-title">Генератор паролей</h1>
    </header>

    <!-- Content -->
    <main class="content">
        <div class="generator-container">
            <!-- Текстовый блок с паролем -->
            <div class="password-display-area">
                <div class="password-display" @onclick="CopyPassword" id="generatedPassword">@generatedPassword</div>
                
                <!-- Кнопка генерации -->
                <button class="btn-generate" @onclick="_GeneratePassword">
                    <img src="icons/generator.svg" alt="Сгенерировать" />
                    <span>Сгенерировать</span>
                </button>
            </div>

            <!-- Набор галочек -->
            <div class="options-section">
                <h3>Настройки пароля</h3>
                
                <!-- Длина пароля -->
                <div class="form-group">
                    <label for="passwordLength">Длина пароля:</label>
                    <input type="number" id="passwordLength" class="form-control" @bind="passwordLength" @bind:event="oninput" min="4" max="255" />
                </div>

                <!-- Цифры -->
                 <div class="checkbox-item">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="includeDigits" @onclick="setSymbolsType" />
                        <span class="checkbox-text">Цифры (0-9)</span>
                    </label>
                </div>

                <!-- Буквы латинского алфавита (2 галочки) -->
                <div class="checkbox-item">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="includeLowercase" @onclick="setSymbolsType" />
                        <span class="checkbox-text">Строчные буквы (a-z)</span>
                    </label>
                </div>

                <div class="checkbox-item">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="includeUppercase" @onclick="setSymbolsType" />
                        <span class="checkbox-text">Прописные буквы (A-Z)</span>
                    </label>
                </div>

                <!-- Специальные символы -->
                <div class="checkbox-item">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="includeSpecial" @onclick="setSymbolsType" />
                        <span class="checkbox-text">Специальные символы (!&#64;#$%^&*)</span>
                    </label>
                </div>
            </div>

            <!-- Информация о силе пароля -->
            @if (generatedPassword != "Нажмите кнопку для генерации" && generatedPassword != "Должен быть выбран хотя бы один тип символов")
            {
                <div class="password-strength">
                    <h3>Сила пароля</h3>
                    <div class="strength-meter">
                        <div class="strength-bar @GetStrengthClass()"
                             style="width: @GetStrengthPercentage()%;"></div>
                    </div>
                    <div class="strength-text">@GetStrengthText()</div>
                    <div class="strength-details">
                        <small>Активных опций: @GetActiveOptionsCount() из 4</small>
                    </div>
                </div>
            }
            @if (copied)
            {
                <div class="copy-toast">
                    <span class="copy-toast-icon">✓</span>
                    <span class="copy-toast-text">Пароль скопирован</span>
                </div>
            }

        </div>
    </main>

</div>

@code {
    // Поле для отображения сгенерированного пароля
    private string generatedPassword = "Нажмите кнопку для генерации";
    // Длина пароля
    private byte passwordLength = 12;
    // Набор галочек 
    private bool includeDigits = true;      // Цифры
    private bool includeLowercase = true;   // Строчные буквы
    private bool includeUppercase = true;   // Прописные буквы
    private bool includeSpecial = false;    // Специальные символы

    // Копирование
    private bool copied;

    public int PasswordLength
    {
        get => passwordLength;
        set => passwordLength = Math.Clamp((byte)value, (byte)4, (byte)255);
    }

    // Кнопка генерации 
    private void _GeneratePassword()
    {
        try
        {
            generatedPassword = PasswordGenerator.GeneratePassword(includeLowercase, includeUppercase, includeDigits, includeSpecial, passwordLength).ToString();
        }
        catch (ArgumentException e)
        {
            generatedPassword = e.Message;
        }
    }

    private async Task CopyPassword()
    {
        if (!string.IsNullOrEmpty(generatedPassword) &&
            generatedPassword != "Нажмите кнопку для генерации" &&
            generatedPassword != "Должен быть выбран хотя бы один тип символов")
        {
            await Clipboard.SetTextAsync(generatedPassword);
            copied = true;
            StateHasChanged();

            await Task.Delay(1500);

            copied = false;
            StateHasChanged();
        }
    }

    // Подсчет количества активных опций
    private int GetActiveOptionsCount()
    {
        int number = Convert.ToInt16(includeDigits) + Convert.ToInt16(includeLowercase) + Convert.ToInt16(includeUppercase) + Convert.ToInt16(includeSpecial);
        return number;
    }

    private string GetStrengthClass()
    {
        int active = GetActiveOptionsCount();

        if (active <= 1) return "strength-weak";
        if (active <= 3) return "strength-medium";
        return "strength-strong";
    }

    // Получение процента для прогресс-бара
    private int GetStrengthPercentage()
    {
        int percentage = GetActiveOptionsCount();
        return percentage*25;
    }

    private void setSymbolsType()
    {
        generatedPassword = "Нажмите кнопку для генерации";
    }

    // Получение текстового описания силы пароля
    private string GetStrengthText()
    {
        int active = GetActiveOptionsCount();

        return active switch
        {
            0 => "Включите хотя бы одну опцию",
            1 => "Слабый",
            2 => "Нормальный",
            3 => "Хороший",
            4 => "Отличный",
            _ => ""
        };
    }
}