@inject IJSRuntime JS

<div class="detail-overlay" @onclick="OnClose">
    <div class="detail-container" @onclick:stopPropagation="true">
        <div class="detail-header">
            <div class="detail-icon">
                <img src="@GetIconPath()" alt="@GetItemTypeName()" />
            </div>
            <h2>@GetTitle()</h2>
            <button class="close-button" @onclick="OnClose">
                <img src="icons/close.svg" alt="Р—Р°РєСЂС‹С‚СЊ" />
            </button>
        </div>

        <div class="detail-body">
            @if (DetailType == "password" && PasswordData != null)
            {
                <div class="detail-section">
                    <div class="detail-field">
                        <label>РќР°Р·РІР°РЅРёРµ</label>
                        <div class="field-value">@PasswordData.Title</div>
                    </div>

                    <div class="detail-field">
                        <label>Р›РѕРіРёРЅ</label>
                        <div class="field-value copyable" @onclick="@(() => CopyToClipboard(PasswordData.Login))">
                            @PasswordData.Login
                            <img src="icons/copy.svg" class="copy-icon" alt="РљРѕРїРёСЂРѕРІР°С‚СЊ" />
                        </div>
                    </div>

                    <div class="detail-field">
                        <label>РџР°СЂРѕР»СЊ</label>
                        <div class="field-value password-field">
                            <span class="@(showPassword ? "" : "password-hidden")">
                                @(showPassword ? PasswordData.Password : "вЂўвЂўвЂўвЂўвЂўвЂўвЂўвЂў")
                            </span>
                            <button class="icon-button-small" @onclick="TogglePasswordVisibility">
                                <img src="@(showPassword ? "icons/eye-off.svg" : "icons/eye.svg")" alt="РџРѕРєР°Р·Р°С‚СЊ/СЃРєСЂС‹С‚СЊ" />
                            </button>
                            <button class="icon-button-small" @onclick="@(() => CopyToClipboard(PasswordData.Password))">
                                <img src="icons/copy.svg" alt="РљРѕРїРёСЂРѕРІР°С‚СЊ" />
                            </button>
                        </div>
                    </div>
                </div>
            }
            else if (DetailType == "card" && CardData != null)
            {
                <div class="detail-section">
                    <div class="card-preview-large">
                        <div class="card-chip-large"></div>
                        <div class="card-number-large">@FormatCardNumber(CardData.CardNumber)</div>
                        <div class="card-meta-large">
                            <div>
                                <label>Р’Р»Р°РґРµР»РµС†</label>
                                <div>@CardData.CardHolder.ToUpperInvariant()</div>
                            </div>
                            <div>
                                <label>РЎСЂРѕРє</label>
                                <div>@CardData.ExpiryDate</div>
                            </div>
                        </div>
                    </div>

                    <div class="detail-field">
                        <label>РќР°Р·РІР°РЅРёРµ РєР°СЂС‚С‹</label>
                        <div class="field-value">@CardData.Title</div>
                    </div>

                    <div class="detail-field">
                        <label>РќРѕРјРµСЂ РєР°СЂС‚С‹</label>
                        <div class="field-value copyable" @onclick="@(() => CopyToClipboard(CardData.CardNumber))">
                            @FormatCardNumber(CardData.CardNumber)
                            <img src="icons/copy.svg" class="copy-icon" alt="РљРѕРїРёСЂРѕРІР°С‚СЊ" />
                        </div>
                    </div>

                    <div class="detail-field">
                        <label>Р’Р»Р°РґРµР»РµС†</label>
                        <div class="field-value copyable" @onclick="@(() => CopyToClipboard(CardData.CardHolder))">
                            @CardData.CardHolder.ToUpperInvariant()
                            <img src="icons/copy.svg" class="copy-icon" alt="РљРѕРїРёСЂРѕРІР°С‚СЊ" />
                        </div>
                    </div>

                    <div class="detail-row">
                        <div class="detail-field">
                            <label>РЎСЂРѕРє РґРµР№СЃС‚РІРёСЏ</label>
                            <div class="field-value">@CardData.ExpiryDate</div>
                        </div>

                        <div class="detail-field">
                            <label>CVV</label>
                            <div class="field-value password-field">
                                <span class="@(showCvv ? "" : "password-hidden")">
                                    @(showCvv ? CardData.Cvv : "вЂўвЂўвЂў")
                                </span>
                                <button class="icon-button-small" @onclick="ToggleCvvVisibility">
                                    <img src="@(showCvv ? "icons/eye-off.svg" : "icons/eye.svg")" alt="РџРѕРєР°Р·Р°С‚СЊ/СЃРєСЂС‹С‚СЊ" />
                                </button>
                                <button class="icon-button-small" @onclick="@(() => CopyToClipboard(CardData.Cvv))">
                                    <img src="icons/copy.svg" alt="РљРѕРїРёСЂРѕРІР°С‚СЊ" />
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (DetailType == "note" && NoteData != null)
            {
                <div class="detail-section">
                    <div class="detail-field">
                        <label>РќР°Р·РІР°РЅРёРµ Р·Р°РјРµС‚РєРё</label>
                        <div class="field-value">@NoteData.Title</div>
                    </div>

                    <div class="detail-field">
                        <label>РЎРѕРґРµСЂР¶Р°РЅРёРµ</label>
                        <div class="field-value note-content">@NoteData.Content</div>
                    </div>
                </div>
            }
        </div>

        <div class="detail-footer">
            <button class="btn btn-secondary" @onclick="OnEdit">
                <img src="icons/edit.svg" alt="Р РµРґР°РєС‚РёСЂРѕРІР°С‚СЊ" />
                <span>Р РµРґР°РєС‚РёСЂРѕРІР°С‚СЊ</span>
            </button>
            <button class="btn btn-danger" @onclick="OnDelete">
                <img src="icons/delete.svg" alt="РЈРґР°Р»РёС‚СЊ" />
                <span>РЈРґР°Р»РёС‚СЊ</span>
            </button>
        </div>
    </div>
</div>

@code {
    [Parameter] public string DetailType { get; set; } = "password";
    [Parameter] public PasswordEntry? PasswordData { get; set; }
    [Parameter] public CardEntry? CardData { get; set; }
    [Parameter] public NoteEntry? NoteData { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }

    private bool showPassword = false;
    private bool showCvv = false;

    private string GetIconPath()
    {
        return DetailType switch
        {
            "password" => "icons/login.svg",
            "card" => "icons/card.svg",
            "note" => "icons/note.svg",
            _ => "icons/file.png"
        };
    }

    private string GetItemTypeName()
    {
        return DetailType switch
        {
            "password" => "РџР°СЂРѕР»СЊ",
            "card" => "РљР°СЂС‚Р°",
            "note" => "Р—Р°РјРµС‚РєР°",
            _ => "Р­Р»РµРјРµРЅС‚"
        };
    }

    private string GetTitle()
    {
        return DetailType switch
        {
            "password" => PasswordData?.Title ?? "",
            "card" => CardData?.Title ?? "",
            "note" => NoteData?.Title ?? "",
            _ => ""
        };
    }

    private string FormatCardNumber(string? number)
    {
        if (string.IsNullOrWhiteSpace(number))
            return "вЂўвЂўвЂўвЂў вЂўвЂўвЂўвЂў вЂўвЂўвЂўвЂў вЂўвЂўвЂўвЂў";
        
        var digits = new string(number.Where(char.IsDigit).ToArray());
        if (digits.Length < 16)
            return number ?? "";
        
        return string.Join(" ", Enumerable.Range(0, 4).Select(i => digits.Substring(i * 4, 4)));
    }

    private void TogglePasswordVisibility() => showPassword = !showPassword;
    private void ToggleCvvVisibility() => showCvv = !showCvv;

    private async Task CopyToClipboard(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch
        {
        }
    }
}