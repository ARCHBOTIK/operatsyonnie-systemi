@page "/syncauth"
@inject TcpBridge SyncBridge
@inject NavigationManager Navigation
@inject MasterPasswordPage MasterPasswordPage
@implements IDisposable

<div class="screen sync-page">
    <header class="appbar">
        <h1 class="appbar-title">Обмен</h1>
    </header>

    <main class="content">
        <div class="sync-auth-container">
            <div class="sync-auth-card">
                <div class="sync-auth-header">
                    <h2>Безопасный перенос базы</h2>
                    <p class="subtitle">Используется сквозное шифрование и одноразовый код сопряжения.</p>
                </div>

                <div class="sync-actions mode-buttons">
                    <button class="sync-button @(selectedMode == SyncTransferMode.Upload ? "primary" : "secondary")" @onclick="@(() => SelectMode(SyncTransferMode.Upload))">
                        Передать базу
                    </button>
                    <button class="sync-button @(selectedMode == SyncTransferMode.Download ? "primary" : "secondary")" @onclick="@(() => SelectMode(SyncTransferMode.Download))">
                        Принять базу
                    </button>
                </div>

                <div class="sync-card">
                    @if (selectedMode == SyncTransferMode.Upload)
                    {
                        <div class="form-group">
                            <label>IP-адрес устройства-получателя</label>
                            <input type="text" class="form-control" @bind="peerAddress" placeholder="Например: 192.168.0.15" />
                        </div>

                        <div class="form-group">
                            <label>Одноразовый код сопряжения (с экрана получателя)</label>
                            <input type="text" class="form-control" @bind="peerPairingCode" placeholder="XXXX-XXXX-XXXX" />
                        </div>

                        @if (!hasTransferableVault)
                        {
                            <div class="sync-result warning">
                                <span>•</span>
                                <span>На этом устройстве пока нет готовой базы для передачи.</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="sync-info-box">
                            <p>@addressHint</p>
                        </div>

                        @if (receiverPairingSecret is not null)
                        {
                            <div class="form-group text-center" style="margin: 16px 0;">
                                <label style="font-weight: bold; margin-bottom: 6px; display: block;">Одноразовый код сопряжения:</label>
                                <div style="font-size: 1.4rem; font-family: monospace; letter-spacing: 2px; font-weight: bold; padding: 10px; background: rgba(23, 191, 166, 0.1); border-radius: 8px; border: 1px dashed #17BFA6;">
                                    @receiverPairingSecret.FormattedCode
                                </div>
                                <small style="display: block; margin-top: 4px; color: #888;">Действителен 3 минуты. Введите его на передающем устройстве.</small>
                            </div>
                        }

                        @if (hasLocalVault)
                        {
                            <div class="sync-result warning">
                                <span>•</span>
                                <span>Локальная база будет атомарно заменена принятой копией. После импорта приложение запросит повторный вход.</span>
                            </div>
                        }
                    }

                    @if (!string.IsNullOrWhiteSpace(validationError))
                    {
                        <div class="sync-result error">
                            <span>✖</span>
                            <span>@validationError</span>
                        </div>
                    }

                    @if (syncResult is not null)
                    {
                        <div class="sync-result @(syncResult.Success ? "success" : syncResult.Cancelled ? "warning" : "error")">
                            <span>@(syncResult.Success ? "✓" : syncResult.Cancelled ? "•" : "✖")</span>
                            <span>@syncResult.Message</span>
                        </div>
                    }

                    @if (isSyncing)
                    {
                        <div class="sync-progress">
                            <div class="progress-header">
                                <span>@progressTitle</span>
                            </div>
                            <div class="progress-bar-container">
                                <div class="progress-bar-fill" style="width: @progressPercent%"></div>
                            </div>
                            <div class="progress-speed">Операцию можно отменить в любой момент.</div>
                        </div>
                    }

                    <div class="sync-actions">
                        <button class="sync-button primary" @onclick="StartSyncAsync" disabled="@isSyncing">
                            @(selectedMode == SyncTransferMode.Upload ? "Передать базу" : "Ожидать и принять базу")
                        </button>

                        @if (isSyncing)
                        {
                            <button class="sync-button secondary" @onclick="CancelSync">Отменить</button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

@code {
    private string peerAddress = string.Empty;
    private string peerPairingCode = string.Empty;
    private string validationError = string.Empty;
    private string addressHint = string.Empty;
    private string progressTitle = "Подготовка...";
    private SyncTransferMode selectedMode;
    private SyncOperationResult? syncResult;
    private CancellationTokenSource? syncCancellation;
    private PairingSecret? receiverPairingSecret;
    private bool isSyncing;
    private bool hasTransferableVault;
    private bool hasLocalVault;
    private int progressPercent;

    protected override void OnInitialized()
    {
        selectedMode = SyncBridge.GetPreferredMode();
        RefreshState();
    }

    private void RefreshState()
    {
        hasTransferableVault = SyncBridge.HasTransferableVault();
        hasLocalVault = SyncBridge.LocalVaultExists();
        addressHint = SyncBridge.GetPeerAddressHint();
        validationError = string.Empty;

        if (selectedMode == SyncTransferMode.Download && (receiverPairingSecret is null || receiverPairingSecret.IsExpired))
        {
            receiverPairingSecret?.Dispose();
            receiverPairingSecret = PairingSecret.Generate();
        }
    }

    private void SelectMode(SyncTransferMode mode)
    {
        selectedMode = mode;
        validationError = string.Empty;
        syncResult = null;
        RefreshState();
    }

    private async Task StartSyncAsync()
    {
        validationError = string.Empty;
        syncResult = null;
        RefreshState();

        if (selectedMode == SyncTransferMode.Upload)
        {
            if (!hasTransferableVault)
            {
                validationError = "На этом устройстве нет базы для передачи.";
                return;
            }

            if (string.IsNullOrWhiteSpace(peerAddress))
            {
                validationError = "Введите IP-адрес устройства-получателя.";
                return;
            }

            if (string.IsNullOrWhiteSpace(peerPairingCode))
            {
                validationError = "Введите одноразовый код сопряжения с экрана получателя.";
                return;
            }
        }
        else
        {
            if (receiverPairingSecret is null || receiverPairingSecret.IsExpired)
            {
                receiverPairingSecret?.Dispose();
                receiverPairingSecret = PairingSecret.Generate();
            }
        }

        isSyncing = true;
        progressPercent = 20;
        progressTitle = selectedMode == SyncTransferMode.Upload
            ? "Выполняем безопасное подключение..."
            : "Ожидаем подключение и проверку кода сопряжения...";
        syncCancellation = new CancellationTokenSource();

        try
        {
            progressPercent = 55;
            syncResult = selectedMode == SyncTransferMode.Upload
                ? await SyncBridge.SendVaultToPeerAsync(peerAddress.Trim(), peerPairingCode.Trim(), syncCancellation.Token)
                : await SyncBridge.ReceiveVaultFromPeerAsync(receiverPairingSecret!, syncCancellation.Token);

            progressPercent = syncResult.Success ? 100 : progressPercent;

            if (syncResult.Success && selectedMode == SyncTransferMode.Download)
            {
                MasterPasswordPage.PrepareForLock();
                Navigation.NavigateTo("/");
            }
        }
        finally
        {
            isSyncing = false;
            syncCancellation?.Dispose();
            syncCancellation = null;
            RefreshState();
        }
    }

    private void CancelSync()
    {
        syncCancellation?.Cancel();
        syncResult = new SyncOperationResult
        {
            Cancelled = true,
            Mode = selectedMode,
            Message = "Операция отменена пользователем."
        };
        isSyncing = false;
        progressPercent = 0;
    }

    public void Dispose()
    {
        syncCancellation?.Cancel();
        syncCancellation?.Dispose();
        receiverPairingSecret?.Dispose();
        receiverPairingSecret = null;
    }
}
